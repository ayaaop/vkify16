{extends "../@layout.latte"}
{block title}{$club->getName()} » {_statistics}{/block}

{block headIncludes}
    <link rel="stylesheet" data-vkify-route-style="graph" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/graph.css">
{/block}

{block content}
    <div class="wide_column_left">
        <div class="wide_column_left">
            <div class="narrow_column_wrap">
                <div class="narrow_column">
                    {var $menuItems = [
                        [
                            'url' => "/club{$club->getId()}/edit",
                            'title' => 'main',
                            'active' => false
                        ],
                        [
                            'url' => "/club{$club->getId()}/backdrop",
                            'title' => 'backdrop_short',
                            'active' => false
                        ],
                        [
                            'url' => "/club{$club->getId()}/followers",
                            'title' => 'followers',
                            'active' => false
                        ],
                        [
                            'url' => "/club{$club->getId()}/followers/req",
                            'title' => 'req',
                            'condition' => $club->isClosed()
                        ],
                        [
                            'url' => "/club{$club->getId()}/stats",
                            'title' => 'statistics',
                            'active' => true
                        ]
                    ]}
                    {include "../components/ui_rmenu.latte", items => $menuItems, ownblockData => $club, additionalCssClass => 'show_as_menu_on_mobile'}
                </div>
            </div>
            <div class="wide_column_wrap">
                <div class="wide_column">
                    <div class="page_block">
                        {include "../components/page_block_header.latte", title => "statistics"}
                        <div class="page_padding">
                            <h4>{_coverage}</h4>
                            <p>{_coverage_this_week}</p>
                            <div id="reachChart" class="group_stats_plot" aria-label="{_coverage}" data-group-stats="{json_encode(vkifyGroupStatsGraphData($reach))}"></div>
                        
                            <h4>{_views}</h4>
                            <p>{_views_this_week}</p>
                            <div id="viewsChart" class="group_stats_plot" aria-label="{_views}" data-group-stats="{json_encode(vkifyGroupStatsGraphData($views))}"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
{/block}
