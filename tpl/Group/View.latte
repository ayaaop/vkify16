{php if (!function_exists('vkifyFormatCount')) require_once \OPENVK_ROOT . '/themepacks/vkify16/res/php/vkify_helpers.php';}
{extends "../@layout.latte"}
{import "mobile_profile.latte"}
{var $transparentAppbar = true}
{var $backdrops = $club->getBackDropPictureURLs()}
{var $canEdit = $thisUser && $club->canBeModifiedBy($thisUser)}
{var $canReport = $thisUser->getId() != $club->getOwner()->getId()}
{block title}{$club->getName()}{/block}

{block headIncludes}
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/profile.css" data-vkify-route-style="profile" />
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/settings.css" data-vkify-route-style="settings" />
{/block}

{block appbar_extra}
<div class="mobileonly" id="group_appbar_extra">
    <button class="appbar-extra-btn ui_actions_menu_wrap" id="groupAppbarMoreBtn" aria-label="More actions" onclick='{="uiActionsMenu.toggle(this, null, {menuId: \"profile_actions_tooltip\"});"|noescape}'>
        <svg viewBox="0 0 12 24" width="24" height="24" fill="currentColor"><use href="#more-vertical-24"></use></svg>
    </button>
</div>
{/block}


{block content}
    {var $audios = iterator_to_array($audios)}
    {var $albums = iterator_to_array($albums)}
    {var $videos = iterator_to_array($videos ?? [])}
    {var $topics = iterator_to_array($topics)}
    {var $docs   = iterator_to_array((new \openvk\Web\Models\Repositories\Documents())->getDocumentsByOwner($club->getRealId())->offsetLimit(0, 6))}
    {var $followersCount = $club->getFollowersCount()}
    {var $potentialCount = $club->getPotentialFollowersCount()}
    {var $owner = $club->getOwner()}
    {var $descPlain = $club->getDescription() ?? ''}
    {var $descHtml = $club->getDescriptionHtml()}
    {var $pinnedPost = (new \openvk\Web\Models\Repositories\Posts())->getPinnedPost($club->getId() * -1)}
    {var $hasMoreInfo = $canEdit || $descPlain !== '' || $club->getWebsite() || in_array($club->getAdministratorsListDisplay(), [0, 1])}

    {include #mobileProfile, $hasMoreInfo, $albums, $audios, $videos, $topics, $followersCount, $potentialCount, $pinnedPost, $descHtml, $descPlain, $docs}

    {if $hasMoreInfo}
    <script>
    function __mobileGroupShowMore() {
        var el = document.getElementById('mobile_group_more_info_content');
        MessageBox(tr('additional_information'), el ? el.innerHTML : '', [tr('close')], [Function.noop]).addClass('ovk-msg-sheet');
    }
    </script>
    {/if}

    <div class="wide_column_left">
        <div class="narrow_column_wrap nomobile">
            <div class="narrow_column">
			    {var $avatarPhoto = $club->getAvatarPhoto()}
    			{var $avatarLink = ((is_null($avatarPhoto) ? FALSE : $avatarPhoto->isAnonymous()) ? "/photo" . ("s/" . base_convert((string) $avatarPhoto->getId(), 10, 32)) : $club->getAvatarLink())}
				{var $avatarSizes = $avatarPhoto ? $avatarPhoto->getSizes() : null}
				{var $avatarNormal = $avatarSizes['normal'] ?? null}
				{var $avatarPrettyId = $avatarPhoto ? $avatarPhoto->getPrettyId() : ''}
				{var $avatarFullUrl = $avatarPhoto ? $avatarPhoto->getURL() : ''}
				{var $avatarLargeUrl = $avatarPhoto ? $avatarPhoto->getURLBySizeId('large') : ''}
				{var $avatarPhotoId = $avatarPhoto ? $avatarPhoto->getPrettyId() . ($avatarPhoto->getAccessKey() ? '_' . $avatarPhoto->getAccessKey() : '') : null}
				<div class="page_block photo_block">
					<div class="avatar_block" data-club="{$club->getId()}">
						<div class="avatar_block_inner">
							{if $canEdit}
								<a {if $avatarPhoto}style="display:none"{/if} class="add_image_text" id="vkify_add_image">{_add_image}</a>
								<div {if !$avatarPhoto}style="display:none"{/if} class="avatar_controls">
									<div class="avatarDelete hoverable"></div>
									<div class="avatar_variants">
										<a class="_add_image hoverable"><span>{_upload_new_picture}</span></a>
										<a class="_pe_avatar_edit hoverable" data-pe-action="pe" data-photo-id="{$avatarPrettyId}" data-src="{$avatarFullUrl}" data-large-src="{$avatarLargeUrl}"><span>{=vkifyTr('pe_act_photoeditor')}</span></a>
									</div>
								</div>
							{/if}
							<a href="{$avatarLink|nocheck}" style="display: block; line-height: 0;">
								{include '../components/avatar.latte', author => $club, size => 'normal', id => 'bigAvatar', width => ($avatarNormal ? $avatarNormal->width : 200), height => ($avatarNormal ? $avatarNormal->height : 200), style => 'width: 100%; image-rendering: -webkit-optimize-contrast;', onclick => ($avatarPhotoId ? "PhotoViewer.openById('{$avatarPhotoId}', event);" : null)}
							</a>
						</div>
					</div>
					<div class="profile_actions clear_fix">
						{ifset $thisUser}
							{var $subStatus = $club->getSubscriptionStatus($thisUser)}
							{var $isMaybe = $thisUser ? $club->getFollowersQuery()->where(['follower' => $thisUser->getId(), 'flags' => 1])->fetch() : null}
							{var $eventFlag = $subStatus ? ($isMaybe ? 1 : 0) : -1}
							{if !$canEdit && $club->canWriteMessage($thisUser)}
								<a class="button button_blue button_wide profile_action_btn" onclick="showUserDialog(event, {$club->getRealId()})" href="/im?sel={$club->getRealId()}">
									{_send_message}
								</a>
							{/if}
							<div class="profile_actions_split">
								{if !$subStatus}
									<form action="/setSub/club" method="post" class="profile_link_form fl_l">
										<input type="hidden" name="act" value="add" />
										<input type="hidden" name="id"  value="{$club->getId()}" />
										<input type="hidden" name="hash" value="{$csrfToken}" />
										<input type="submit" value="{if $club->isEvent()}{_ill_come_to_meeting}{else}{_join_community}{/if}" class="button button_wide" />
									</form>
								{else}
									<div class="profile_sub_wrapper ui_actions_menu_wrap ui_actions_menu_no_chevron" onclick='{="uiActionsMenu.toggle(this, null, {noAnimate: true});"|noescape}'>
										<button class="button button_wide button_gray fl_l profile_sub_btn" id="profile_sub_btn">
											{if $club->isEvent()}{if $eventFlag == 1}{_i_might_come_to_meeting}{else}{_ill_come_to_meeting}{/if}{else}{_leave_community}{/if} <span class="profile_sub_arrow"></span>
										</button>
										<div id="profile_sub_tooltip" class="ui_actions_menu" data-club-id="{$club->getId()}" data-current-flag="{$eventFlag}">
											<form style="display:none" data-action="going" action="/setSub/club" method="post">
												<input type="hidden" name="act" value="add" />
												<input type="hidden" name="flag" value="0" />
												<input type="hidden" name="id"  value="{$club->getId()}" />
												<input type="hidden" name="hash" value="{$csrfToken}" />
											</form>
											<form style="display:none" data-action="maybe" action="/setSub/club" method="post">
												<input type="hidden" name="act" value="add" />
												<input type="hidden" name="flag" value="1" />
												<input type="hidden" name="id"  value="{$club->getId()}" />
												<input type="hidden" name="hash" value="{$csrfToken}" />
											</form>
											<form style="display:none" data-action="notgoing" action="/setSub/club" method="post">
												<input type="hidden" name="act" value="rem" />
												<input type="hidden" name="id"  value="{$club->getId()}" />
												<input type="hidden" name="hash" value="{$csrfToken}" />
											</form>
											{if $club->isEvent()}
												<a href="javascript:void(0)" data-event-action="going">{_ill_come_to_meeting}</a>
												<a href="javascript:void(0)" data-event-action="maybe">{_i_might_come_to_meeting}</a>
												<a href="javascript:void(0)" data-event-action="notgoing">{_ill_not_come_to_meeting}</a>
											{else}
												<a href="javascript:void(0)" data-event-action="notgoing">{_leave_community}</a>
											{/if}
											<div class="separator"></div>
											<a n:if="!$club->isHideFromGlobalFeedEnabled()" id="__ignoreSomeone" onclick="onIgnoreSomeoneClick(event)" data-val='{!$ignore_status ? 1 : 0}' data-id="{$club->getRealId()}">
												{if !$ignore_status}{_ignore_club}{else}{_unignore_club}{/if}
											</a>
										</div>
									</div>
								{/if}
								<div class="profile_more_wrapper ui_actions_menu_wrap ui_actions_menu_no_chevron" onclick='{="uiActionsMenu.toggle(this, null, {menuId: \"profile_actions_tooltip\", noAnimate: true, align: \"left\"});"|noescape}'>
									<button class="button button_gray profile_more_btn fl_r" id="profile_more_btn">
										{_actions}
										<span class="clear_fix">&nbsp;</span>
									</button>
									<div id="profile_actions_tooltip" class="ui_actions_menu">
											{if $canEdit}
												<a href="/club{$club->getId()}/edit">{_edit_group}</a>
												<a href="/club{$club->getId()}/stats" rel="nofollow">{_statistics}</a>
												{if $club->isMessagesEnabled()}
													<a href="/im?as={$club->getRealId()}">{_view_group_messages}</a>
												{/if}
												{var $clubPinned = $thisUser->isClubPinned($club)}
												<a href="/groups_pin?club={$club->getId()}&hash={rawurlencode($csrfToken)}" n:if="$clubPinned || $thisUser->getPinnedClubCount() <= 10" id="_pinGroup" data-group-name="{$club->getName()}" data-group-url="{$club->getUrl()}">
													{if $clubPinned}
														{_remove_from_left_menu}
													{else}
														{_add_to_left_menu}
													{/if}
												</a>
											{/if}
											{if $thisUser->getChandlerUser()->can("access")->model("admin")->whichBelongsTo(NULL)}
												<div n:if="$canEdit" class="separator"></div>
												<a href="/admin/clubs/id{$club->getId()}">{_manage_group_action}</a>
												<a href="/admin/logs?obj_id={$club->getId()}&obj_type=Club">{_last_actions}</a>
												<div n:if="$canReport" class="separator"></div>
											{/if}
											{if $canReport}
												<a href="javascript:reportClub({$club->getId()})">{_report}</a>
											{/if}
									</div>
								</div>
							</div>
						{else}
							<div class="guest_actions">
								{=vkifyTr('guest_actions_group', $club->getName())|noescape}
							</div>
						{/ifset}
					</div>
				</div>
				<div class="page_block" id="group_counters" n:if="$thisUser && $club->isEvent()">
					<div class="group_counters_wrap clear_fix">
						<div class="group_counters full">
							<a class="page_counter" href="/club{$club->getId()}/followers">
								<div class="count">{=vkifyFormatCount($club->getFollowersCount())}</div>
								<div class="label">{_event_comers}</div>
							</a>
							<a class="page_counter" href="/club{$club->getId()}/followers?mightcome=1">
								<div class="count">{=vkifyFormatCount($club->getPotentialFollowersCount())}</div>
								<div class="label">{_event_potential_comers}</div>
							</a>
						</div>
					</div>
				</div>
				<div n:if="$followersCount > 0" class="page_block module people_module">

						{include '../components/module_header.latte', href => '/club' . ($club->getId()) . '/followers', label => tr('participants'), count => $followersCount}
						<div class="module_body">
							<div class="search_row" n:foreach="array_chunk(array_slice(iterator_to_array($club->getFollowers(1)), 0, 6), 3) as $followerRow">
								<div class="people_cell" n:foreach="$followerRow as $follower">
									<a class="people_cell_ava" href="{$follower->getURL()}">
										{include '../components/avatar.latte', author => $follower, size => 'miniscule', width => 50, height => 50, alt => $follower->getFirstName(), class => 'people_cell_img'}
									</a>
									<div class="people_cell_name"><a href="{$follower->getURL()}">{$follower->getFirstName()}</a></div>
								</div>
							</div>
						</div>
				</div>
				<div n:if="$thisUser && $club->isEvent() && $club->getPotentialFollowersCount() > 0" class="page_block module people_module">
						{include '../components/module_header.latte', href => '/club' . ($club->getId()) . '/followers?mightcome=1', label => tr('event_potential_comers'), count => $club->getPotentialFollowersCount()}
						<div class="module_body">
							<div class="search_row" n:foreach="array_chunk(array_slice(iterator_to_array($club->getPotentialFollowers(1)), 0, 6), 3) as $followerRow">
								<div class="people_cell" n:foreach="$followerRow as $follower">
									<a class="people_cell_ava" href="{$follower->getURL()}">
										{include '../components/avatar.latte', author => $follower, size => 'miniscule', width => 50, height => 50, alt => $follower->getFirstName(), class => 'people_cell_img'}
									</a>
									<div class="people_cell_name"><a href="{$follower->getURL()}">{$follower->getFirstName()}</a></div>
								</div>
							</div>
						</div>
				</div>
				<div n:ifcontent class="page_block">
					<div n:if="$albumsCount > 0 || $canEdit" class="module album_module">
						{if $albumsCount > 0}
							{include '../components/module_header.latte', href => '/albums' . ($club->getId() * -1), label => tr('albums'), count => $albumsCount}
							<div class="module_body clear_fix">
								<div class="clear_fix clear page_album_row" n:foreach="array_slice(iterator_to_array($albums), 0, 3) as $album">
									<a href="/album{$album->getPrettyId()}" class="page_album_link {if is_null($album->getCoverPhoto())}page_album_nocover{/if}">
										{var $cover = $album->getCoverPhoto()}
										<div class="page_album_thumb_wrap">
											<img n:if="!is_null($cover)"
												src="{$cover->getURLBySizeId('normal')}"
												class="page_album_thumb" loading="lazy" />
										</div>
										<div class="page_album_title">
											<div class="page_album_size">{$album->getPhotosCount()}</div>
											<div class="page_album_title_text">{$album->getName()}</div>
										</div>
									</a>
								</div>
							</div>
						{elseif $canEdit}
							<a href="/albums{$club->getId() * -1}" class="page_module_upload">
								<div class="page_upload_label page_photos_upload"></div>{_upload_photo}</a>
						{/if}
					</div>

					<div n:if="($videosCount ?? 0) > 0 || $canEdit" class="module video_module">
						{if ($videosCount ?? 0) > 0}
							{include '../components/module_header.latte', href => '/videos' . $club->getRealId(), label => tr('videos'), count => $videosCount}
							<div class="module_body clear_fix">
								<div class="video_row" n:foreach="$videos as $video">
									<a id="videoOpen" data-id="{$video->getPrettyId()}" class="video fl_l" href="/video{$video->getPrettyId()}">
										<div class="video_thumb_label">
											{if $video->getType() != 0}
												<span class="video_thumb_label_item">
													{$video->getType() == \openvk\Web\Models\Entities\Video::TYPE_EMBED ? 'YouTube' : ''}
												</span>
												{if $video->getFormattedLength() != '00:00'}
													<div class="divider"></div>
													{$video->getFormattedLength()}
												{/if}
											{else}
												{$video->getFormattedLength()}
											{/if}
										</div>
										<div class="page_video_play_icon"></div>
										<span class="page_video_thumb" style="background-image: url('{$video->getThumbnailURL()}');"></span>
									</a>
									<div class="info clear">
										<a href="/video{$video->getPrettyId()}">{ovk_proc_strtr($video->getName(), 30)}</a>
									</div>
								</div>
							</div>
						{elseif $canEdit}
							<a href="/videos/upload?gid={$club->getId()}" onclick="showFastVideoUpload(null, event, {$club->getId()}); return false;" class="page_module_upload">
								<div class="page_upload_label page_videos_upload"></div>{_upload_video}</a>
						{/if}
					</div>

					<div n:if="($topicsCount > 0 || $club->isEveryoneCanCreateTopics() || $canEdit) && !$club->isDisplayTopicsAboveWallEnabled()" class="module topics_module">
						{if $topicsCount > 0}
							{include '../components/module_header.latte', href => '/board' . ($club->getId()), label => tr('discussions'), count => $topicsCount}
							<div class="module_body">
								<div class="topic_row" n:foreach="$topics as $topic">
									<div class="topic_info_wrap">
										<a href="/topic{$topic->getPrettyId()}">
											<div class="topic_icon"></div>
											<div class="topic_title">{$topic->getTitle()}</div>
										</a>
										<div class="topic_info">{tr("updated_at", $topic->getUpdateTime())}</div>
									</div>
								</div>
							</div>
						{elseif $club->isEveryoneCanCreateTopics() || $canEdit}
							<a href="/board{$club->getId()}/create" onclick="return showCreateTopicModal(event, {$club->getId()}, {$club->canBeModifiedBy($thisUser) ? 'true' : 'false'})" class="page_module_upload">
								<div class="page_upload_label page_topics_upload"></div>{_create_topic}</a>
						{/if}
					</div>

					<div n:if="$docsCount > 0 || $canEdit" class="module">
						{if $docsCount > 0}
							{include '../components/module_header.latte', href => '/docs' . ($club->getRealId()), label => tr('documents'), count => $docsCount}
							<div class="module_body">
								{foreach array_slice($docs, 0, 3) as $doc}
									{include "../Documents/components/doc.latte", doc => $doc, hideButtons => true, noTags => true}
								{/foreach}
							</div>
						{elseif $canEdit}
							<a class="page_module_upload" onclick="showDocumentUploadDialog(null, {$club->getId()})">
								<div class="page_upload_label page_docs_upload"></div>{_document_uploading_in_general}</a>
						{/if}
					</div>

					<div n:if="$audiosCount > 0 || $canEdit || $club->isEveryoneCanUploadAudios()" class="module audio_module" >
						{if $audiosCount > 0}
							{include '../components/module_header.latte', href => '/audios-' . ($club->getId()), label => tr('audios'), count => $audiosCount}
							<div class="module_body">
								<div class="content_list long">
									<div class="audio" n:foreach="$audios as $audio" style="width: 100%;">
										{include "../Audio/player.latte", audio => $audio, hideButtons => true}
									</div>
								</div>
							</div>
						{elseif $canEdit || $club->isEveryoneCanUploadAudios()}
							<a href="/player/upload?gid={$club->getId()}" onclick="showAudioUploadPopup({ ownerId: -{$club->getId()} }); return false;" class="page_module_upload">
								<div class="page_upload_label page_audios_upload"></div>{_add_audio_to_club}</a>
						{/if}
					</div>
				</div>

				<div n:ifcontent class="page_block">
					{include #clubAdminModules}
				</div>
			</div>
		</div>
		<div class="wide_column_wrap">
			<div class="wide_column">
				<div n:if="!is_null($alert = $club->getAlert())" class="msg msg_yellow">{strpos($alert, "@") === 0 ? tr(substr($alert, 1)) : $alert}</div>
				<div class="page_block info_block nomobile">
					<div class="page_top">
						<h2 class="page_name">{$club->getName()}
							<a class="page_verified" n:if="$club->isVerified()" href="/verify"></a>
						</h2>
					</div>
					{if $pinnedPost}
						{var $infoTabs = [
							[
								'url' => "javascript:void(0)",
								'title' => 'pinned',
								'active' => true,
								'id' => 'group_tab_pinned'
							],
							[
								'url' => "javascript:void(0)",
								'title' => 'information',
								'active' => false,
								'id' => 'group_tab_info'
							]
						]}

						<div class="page_info_header_tabs">
							{include "../components/page_tabs_header.latte", tabs => $infoTabs, id => 'group_info_tabs', white => true}
						</div>	
					{else}
						<h2 class="page_block_h2 page_info_header_tabs">
							<ul class="ui_tabs clear_fix page_info_tabs">
								<li class="ui_tab_default"><div class="ui_tab_plain" href="/club{$club->getId()}">{_information}</div></li>
							</ul>
						</h2>	
					{/if}
					
                    <div id="group_info_content">
					<div id="group_tab_info_content" style="{if $pinnedPost}display: none;{/if}">
						<div class="page_padding info">
							<div class="group_info_block info">
								<div class="group_info_rows">
									{var $descPlain = $club->getDescription() ?? ''}
									<div n:class="group_info_row, info, $canEdit ? vkify_can_inline_edit" n:attr="data-edit-url => $canEdit ? '/club' . $club->getId() . '/edit' : null, data-inline-context => $canEdit ? 'desktop' : null, data-inline-field => $canEdit ? 'about' : null">
										{if $descHtml}
											{include "../components/truncated_text.latte", html => $descHtml, plain => $descPlain, limit => 300, isEditable => $canEdit, editUrl => "/club" . $club->getId() . "/edit"}
										{elseif $canEdit}
											<div class="pv_can_edit pv_desc_cont" data-edit-url="/club{$club->getId()}/edit" role="button" tabindex="0"><span class="pv_no_description">{_desc_none|firstUpper}</span></div>
										{else}
											<span class="nobold">{_desc_none|firstUpper}</span>
										{/if}
									</div>
									<div n:if="$club->getWebsite() || $canEdit" n:class="group_info_row, site, $canEdit ? vkify_can_inline_edit" n:attr="data-edit-url => $canEdit ? '/club' . $club->getId() . '/edit' : null, data-inline-context => $canEdit ? 'desktop' : null, data-inline-field => $canEdit ? 'website' : null">
										{if $club->getWebsite()}
											<div class="line_value">
												<a n:if="$club->getWebsite()" href="{$club->getWebsite()}" rel="ugc" target="_blank">{$club->getWebsite()}</a>
												<span n:if="$canEdit" class="line_div_icon edit" role="button" title="{_edit}"></span>
											</div>
										{elseif $canEdit}
											<div class="pv_can_edit pv_desc_cont" data-edit-url="/club{$club->getId()}/edit" role="button" tabindex="0"><span class="pv_no_description">{_admin_banned_link_not_specified}</span></div>
										{/if}
									</div>
									{include #clubEventDate, mobile => false}
								</div>
							</div>
						</div>
					</div>
					{if $pinnedPost}
					<div id="group_tab_pinned_content">
						<div id="underHeader">
							<div class="wall_posts content scroll_container">
								{include "../components/post.latte", post => $pinnedPost, commentSection => true, onWallOf => true}
							</div>
						</div>
					</div>
					{/if}
                    </div>
				</div>
				<div n:if="($topicsCount > 0 || $club->isEveryoneCanCreateTopics() || $canEdit) && $club->isDisplayTopicsAboveWallEnabled()"
				class="page_block module topics_module nomobile">
					{if $topicsCount > 0}
						{include '../components/module_header.latte', href => '/board' . ($club->getId()), label => tr('discussions'), count => $topicsCount, tag => 'div'}
						<div class="module_body">
							<div class="topic_row" n:foreach="$topics as $topic">
								<div class="topic_info_wrap">
									<a href="/topic{$topic->getPrettyId()}">
										<div class="topic_icon"></div>
										<div class="topic_title">{$topic->getTitle()}</div>
									</a>
									<div class="topic_info">{tr("updated_at", $topic->getUpdateTime())}</div>
								</div>
							</div>
						</div>
					{elseif $club->isEveryoneCanCreateTopics() || $canEdit}
						<a href="/board{$club->getId()}/create" onclick="return showCreateTopicModal(event, {$club->getId()}, {$club->canBeModifiedBy($thisUser) ? 'true' : 'false'})" class="page_module_upload">
							<div class="page_upload_label page_topics_upload"></div>{_create_topic}</a>
					{/if}
				</div>
				{presenter "openvk!Wall->wallEmbedded", -$club->getId()}
			</div>
		</div>
	</div>

{/block}
