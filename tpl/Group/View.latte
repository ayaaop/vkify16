{extends "../@layout.latte"}
{var $transparentAppbar = true}
{var $backdrops = $club->getBackDropPictureURLs()}
{var $canEdit = $thisUser && $club->canBeModifiedBy($thisUser)}
{block title}{$club->getName()}{/block}

{block appbar_extra}
<div class="mobileonly" id="group_appbar_extra">
    <button class="appbar-extra-btn ui_actions_menu_wrap" id="groupAppbarMoreBtn" aria-label="More actions" onclick='{="uiActionsMenu.toggle(this, null, {menuId: \"profile_actions_tooltip\"});"|noescape}'>
        <svg viewBox="0 0 12 24" width="24" height="24" fill="currentColor"><use href="#more-vertical-24"></use></svg>
    </button>
</div>
{/block}

{define mobileProfile, $hasMoreInfo, $albums, $audios, $topics, $followersCount, $potentialCount, $pinnedPost, $descHtml, $descPlain, $docs}
    {include '../components/mobile_profile_hero.latte', entity => $club, name => $club->getName(), status => $club->isEvent() ? tr('event_type_open') : tr('group_type_open'), verified => $club->isVerified()}

    <div class="mobileonly mobile-group-content">

        <div class="page_block mobile-actions-info-block">
            <div class="page_padding mobile-actions-wrap">
                <div class="mobile_profile_actions">
                    {ifset $thisUser}
                        {var $subStatus = $club->getSubscriptionStatus($thisUser)}
                        {var $isMaybe = $thisUser ? $club->getFollowersQuery()->where(['follower' => $thisUser->getId(), 'flags' => 1])->fetch() : null}
                        {var $eventFlag = $subStatus ? ($isMaybe ? 1 : 0) : -1}
                        {if !$subStatus}
                            <form action="/setSub/club" method="post" class="mobile_profile_action_primary">
                                <input type="hidden" name="act" value="add" />
                                <input type="hidden" name="id" value="{$club->getId()}" />
                                <input type="hidden" name="hash" value="{$csrfToken}" />
                                <input type="submit" value="{if $club->isEvent()}{_ill_come_to_meeting}{else}{_join_community}{/if}" class="button button_wide mobile_profile_action_btn" />
                            </form>
                        {else}
                            <div class="profile_sub_wrapper ui_actions_menu_wrap" onclick="uiActionsMenu.toggle(this, null);">
                            <button class="profile_sub_btn button button_wide mobile_profile_action_btn button_gray" id="mobile_profile_sub_btn">
                                {if $club->isEvent()}{if $eventFlag == 1}{_i_might_come_to_meeting}{else}{_ill_come_to_meeting}{/if}{else}{_leave_community}{/if} <span class="profile_sub_arrow"></span>
                            </button>
                            <div id="mobile_profile_sub_tooltip" class="ui_actions_menu" data-club-id="{$club->getId()}" data-current-flag="{$eventFlag}">
                                <form style="display:none" data-action="going" action="/setSub/club" method="post">
                                    <input type="hidden" name="act" value="add" />
                                    <input type="hidden" name="flag" value="0" />
                                    <input type="hidden" name="id" value="{$club->getId()}" />
                                    <input type="hidden" name="hash" value="{$csrfToken}" />
                                </form>
                                <form style="display:none" data-action="maybe" action="/setSub/club" method="post">
                                    <input type="hidden" name="act" value="add" />
                                    <input type="hidden" name="flag" value="1" />
                                    <input type="hidden" name="id" value="{$club->getId()}" />
                                    <input type="hidden" name="hash" value="{$csrfToken}" />
                                </form>
                                <form style="display:none" data-action="notgoing" action="/setSub/club" method="post">
                                    <input type="hidden" name="act" value="rem" />
                                    <input type="hidden" name="id" value="{$club->getId()}" />
                                    <input type="hidden" name="hash" value="{$csrfToken}" />
                                </form>
                                {if $club->isEvent()}
                                    <a href="javascript:void(0)" data-event-action="going">{_ill_come_to_meeting}</a>
                                    <a href="javascript:void(0)" data-event-action="maybe">{_i_might_come_to_meeting}</a>
                                    <a href="javascript:void(0)" data-event-action="notgoing">{_ill_not_come_to_meeting}</a>
                                {else}
                                    <a href="javascript:void(0)" data-event-action="notgoing">{_leave_community}</a>
                                {/if}
                            </div>
                            </div>
                        {/if}
                    {else}
                        <div class="guest_actions">
                            {=vkifyTr('guest_actions_group', $club->getName())|noescape}
                        </div>
                    {/ifset}
                </div>
            </div>

            <div class="mobile-info-rows">
                {var $descPlain = $club->getDescription() ?? ''}
                {if $club->getWebsite()}
                    <a class="mobile-info-row mir-link" href="{$club->getWebsite()}" rel="ugc" target="_blank">
                        <svg class="mir-icon" viewBox="0 0 24 24"><use href="#globe-outline-24"></use></svg>
                        <div class="mir-text">{$club->getWebsite()}</div>
                    </a>
                {/if}
                {if $followersCount > 0 || $potentialCount > 0}
                    <a class="mobile-info-row" href="/club{$club->getId()}/followers">
                        <svg class="mir-icon" viewBox="0 0 24 24"><use href="#users-24"></use></svg>
                        <div class="mir-text">
                            {if $followersCount > 0}{tr('participants', $followersCount)}{/if}
                            {if $followersCount > 0 && $potentialCount > 0}<span class="divider"></span>{/if}
                            {if $potentialCount > 0}{$potentialCount} {_event_potential_comers|lower}{/if}
                        </div>
                    </a>
                {/if}
                {if $club->isEvent() && !is_null($club->getStartDate())}
                    {var $eventStartTs = $club->getStartDate()->timestamp()}
                    {var $eventFinish = $club->getFinishDate()}
                    {var $fmtSameYear = "%e %h " . tr("time_at_sp") . " %R"}
                    {var $fmtWithYear = "%e %B %Y " . tr("time_at_sp") . " %R"}
                    <div class="mobile-info-row">
                        <svg class="mir-icon" viewBox="0 0 24 24"><use href="#clock-24"></use></svg>
                        <div class="mir-text">
                            {$club->getStartDate()->format(date("Y", $eventStartTs) === date("Y") ? $fmtSameYear : $fmtWithYear)}{if !is_null($eventFinish)} — {$eventFinish->format(date("Y", $eventFinish->timestamp()) === date("Y") ? $fmtSameYear : $fmtWithYear)}{/if}
                        </div>
                    </div>
                {/if}
                {if $hasMoreInfo}
                <div class="mobile-info-row mobile-info-row-more" onclick="__mobileGroupShowMore()">
                    <svg class="mir-icon" viewBox="0 0 24 24"><use href="#info-24"></use></svg>
                    <div class="mir-text">{_additional_information}</div>
                </div>
                {/if}
            </div>

        </div>

        {var $canSeeAlbums = $albumsCount > 0}
        {var $canSeeAudios = $audiosCount > 0}
        {var $canSeeDocs   = $docsCount   > 0}
        {var $stripHasContent = $canSeeAlbums || $canSeeAudios || $canSeeDocs}

        {if $canEdit || $stripHasContent}
        <div class="page_block mobile-scroll-modules">

            {if $canSeeAlbums}
                {var $firstAlbum = $albums[0] ?? null}
                <div class="module clear album_module mobile-scroll-card">
                    <a href="/albums{$club->getId() * -1}" class="module_header">
                        <h3 class="header_top clear_fix">
                            <span class="header_label fl_l">{_albums}</span>
                            <span class="header_count fl_l">{$albumsCount}</span>
                        </h3>
                    </a>
                    <a href="{if $firstAlbum}/album{$firstAlbum->getPrettyId()}{else}/albums{$club->getId() * -1}{/if}" n:class="module_body, !($firstAlbum && $firstAlbum->getCoverPhoto()) ? msm-placeholder">
                        {if $firstAlbum && $firstAlbum->getCoverPhoto()}
                            <img src="{$firstAlbum->getCoverPhoto()->getURLBySizeId('normal')}" class="msm-album-cover" alt="" />
                        {else}
                            <svg width="28" height="28" fill="currentColor" viewBox="0 0 28 28"><use href="#camera-28"></use></svg>
                            <span class="msm-placeholder-label">{_upload_photo}</span>
                        {/if}
                    </a>
                </div>
            {elseif $canEdit}
                <div class="module clear album_module mobile-scroll-card">
                    <a href="/albums{$club->getId() * -1}" class="module_header">
                        <h3 class="header_top clear_fix">
                            <span class="header_label fl_l">{_albums}</span>
                        </h3>
                    </a>
                    <a href="/albums{$club->getId() * -1}" class="module_body msm-placeholder">
                        <svg width="28" height="28" fill="currentColor" viewBox="0 0 28 28"><use href="#camera-28"></use></svg>
                        <span class="msm-placeholder-label">{_upload_photo}</span>
                    </a>
                </div>
            {/if}
            {if $canSeeAudios}
                {var $firstAudio = $audios[0] ?? null}
                <div class="module clear mobile-scroll-card">
                    <a href="/audios-{$club->getId()}" class="module_header">
                        <h3 class="header_top clear_fix">
                            <span class="header_label fl_l">{_audios}</span>
                            <span class="header_count fl_l">{$audiosCount}</span>
                        </h3>
                    </a>
                    <a href="/audios-{$club->getId()}" class="module_body msm-placeholder">
                        <svg width="28" height="28" fill="currentColor" viewBox="0 0 28 28"><use href="#music-28"></use></svg>
                        {if $firstAudio}
                            <span class="msm-placeholder-label">{$firstAudio->getTitle()|truncate:40}<br>{$firstAudio->getPerformer()|truncate:40}</span>
                        {/if}
                    </a>
                </div>
            {elseif $canEdit || $club->isEveryoneCanUploadAudios()}
                <div class="module clear mobile-scroll-card">
                    <a href="/audios-{$club->getId()}" class="module_header">
                        <h3 class="header_top clear_fix">
                            <span class="header_label fl_l">{_audios}</span>
                        </h3>
                    </a>
                    <a href="/player/upload?gid={$club->getId()}" class="module_body msm-placeholder">
                        <svg width="28" height="28" fill="currentColor" viewBox="0 0 28 28"><use href="#music-28"></use></svg>
                        <span class="msm-placeholder-label">{_upload_audio_to_group}</span>
                    </a>
                </div>
            {/if}
            {if $canSeeDocs}
                <div class="module clear topics_module notes_module mobile-scroll-card">
                    <a href="/docs{$club->getRealId()}" class="module_header">
                        <h3 class="header_top clear_fix">
                            <span class="header_label fl_l">{_documents}</span>
                            <span class="header_count fl_l">{$docsCount}</span>
                        </h3>
                    </a>
                    {if sizeof($docs) === 1}
                        {var $doc = $docs[0]}
                        {var $docPreview = $doc->hasPreview() ? $doc->getPreview() : null}
                        <a href="/doc{$doc->getPrettyId()}?key={$doc->getAccessKey()}" class="module_body" title="{$doc->getName()}">
                            {if $docPreview}
                                <img src="{$docPreview->getURLBySizeId('normal')}" class="msm-album-cover" alt="" />
                            {else}
                                <div class="msm-placeholder"><div class="doc_icon page_doc_icon page_doc_icon_{$doc->getFileExtension()}"></div></div>
                            {/if}
                        </a>
                    {else}
                        <div class="module_body msm-grid">
                            {foreach array_slice($docs, 0, 6) as $doc}
                                {var $docPreview = $doc->hasPreview() ? $doc->getPreview() : null}
                                <a href="/doc{$doc->getPrettyId()}?key={$doc->getAccessKey()}" class="msm-grid__cell msm-doc-cell" title="{$doc->getName()}">
                                    {if $docPreview}
                                        <img class="msm-grid__img" src="{$docPreview->getURLBySizeId('tiny')}" alt="" />
                                    {else}
                                        <div class="doc_icon page_doc_icon page_doc_icon_{$doc->getFileExtension()}"></div>
                                    {/if}
                                </a>
                            {/foreach}
                        </div>
                    {/if}
                </div>
            {elseif $canEdit}
                <div class="module clear topics_module notes_module mobile-scroll-card">
                    <a href="/docs{$club->getRealId()}" class="module_header">
                        <h3 class="header_top clear_fix">
                            <span class="header_label fl_l">{_documents}</span>
                        </h3>
                    </a>
                    <a href="javascript:showDocumentUploadDialog(null, {$club->getId()})" class="module_body msm-placeholder">
                        <svg width="28" height="28" fill="currentColor" viewBox="0 0 28 28"><use href="#document-28"></use></svg>
                        <span class="msm-placeholder-label">{_document_uploading_in_general}</span>
                    </a>
                </div>
            {/if}

        </div>
        {/if}

        {if $topicsCount > 0}
        <div class="page_block topics_module mobile-topics-module">
            <a href="/board{$club->getId()}" class="module_header">
                <h3 class="header_top clear_fix">
                    <span class="header_label fl_l">{_discussions}</span>
                    <span class="header_count fl_l">{$topicsCount}</span>
                </h3>
            </a>
            <div class="module_body">
                <div class="topic_row" n:foreach="$topics as $topic">
                    <div class="topic_info_wrap">
                        <a href="/topic{$topic->getPrettyId()}">
                            <div class="topic_icon"></div>
                            <div class="topic_title">{$topic->getTitle()}</div>
                        </a>
                        <div class="topic_info">{tr('updated_at', $topic->getUpdateTime())}</div>
                    </div>
                </div>
            </div>
        </div>
        {/if}

    </div>

    {if $pinnedPost}
    <div class="mobileonly page_block">
		{include "../components/post.latte", post => $pinnedPost, commentSection => true, onWallOf => true}
    </div>
    {/if}

    <div id="mobile_group_more_info_content" style="display:none;">
        {var $moreInfoBlocks = []}

        {if $descPlain !== ''}
            {capture $moreInfoBlock}
                <div class="form_group clear_fix">
                    <div class="form_field">
                        <div class="form_label">{_information}</div>
                        <div class="form_data" dir="auto">
                            {include "../components/truncated_text.latte", html => $descHtml, plain => $descPlain, limit => 500}
                        </div>
                    </div>
                </div>
            {/capture}
            {var $moreInfoBlocks = array_merge($moreInfoBlocks, [$moreInfoBlock])}
        {/if}
		{if $club->getAdministratorsListDisplay() == 0 || $club->getAdministratorsListDisplay() == 1}
			{capture $moreInfoBlock}
			<div n:if="$club->getAdministratorsListDisplay() == 0 " class="module page_list_module">
				<a href="/club{$club->getId()}/followers?onlyAdmins=1" class="module_header">
					<h3 class="header_top clear_fix">
						<span class="header_label fl_l">{_creator}</span>
					</h3>
				</a>
				<div class="module_body">
					<div class="line_cell clear_fix">
						{var $author = $club->getOwner()}
						<div class="thumb">
							<a href="{$author->getURL()}">
								{include '../components/avatar.latte', author => $author, size => 'miniscule', class => 'cell_img'}
							</a>
						</div>
						<div n:class="empty($club->getOwnerComment()) ? 'info' : 'desc_info'">
							<a href="{$author->getURL()}" class="people_name">{$author->getCanonicalName()}</a>
							<div n:ifcontent class="people_desc">{$club->getOwnerComment()}</div>
						</div>
					</div>
				</div>
			</div>
			<div n:if="$club->getAdministratorsListDisplay() == 1" class="module page_list_module">
				{var $managersCount = $club->getManagersCount(true)}
				<a href="/club{$club->getId()}/followers?onlyAdmins=1" class="module_header">
					<h3 class="header_top clear_fix">
						<span class="header_label fl_l">{_administrators}</span>
						<span class="header_count fl_l">{$managersCount}</span>
					</h3>
				</a>
				<div class="module_body">
					<div class="line_cell clear_fix" n:if="!$club->isOwnerHidden()">
						{var $author = $club->getOwner()}
						<div class="thumb">
							<a href="{$author->getURL()}">
								{include '../components/avatar.latte', author => $author, size => 'miniscule', class => 'cell_img'}
							</a>
						</div>
						<div n:class="empty($club->getOwnerComment()) ? 'info' : 'desc_info'">
							<a href="{$author->getURL()}" class="people_name">{$author->getCanonicalName()}</a>
							<div n:ifcontent class="people_desc">{$club->getOwnerComment()}</div>
						</div>
					</div>
					<div class="line_cell clear_fix" n:foreach="$club->getManagers(1, true) as $manager">
						{var $user = $manager->getUser()}
						<div class="thumb">
							<a href="{$user->getURL()}">
								{include '../components/avatar.latte', author => $user, size => 'miniscule', class => 'cell_img'}
							</a>
						</div>
						<div n:class="empty($manager->getComment()) ? 'info' : 'desc_info'">
							<a href="{$user->getURL()}" class="people_name">{$user->getCanonicalName()}</a>
							<div n:ifcontent class="people_desc">{$manager->getComment()}</div>
						</div>
					</div>
				</div>
			</div>
			{/capture}
			{var $moreInfoBlocks = array_merge($moreInfoBlocks, [$moreInfoBlock])}
		{/if}

        {foreach $moreInfoBlocks as $block}
            {$block}
            {sep}<hr class="mobile-more-sep">{/sep}
        {/foreach}
    </div>
{/define}

{block content}
    {var $audios = iterator_to_array($audios)}
    {var $albums = iterator_to_array($albums)}
    {var $topics = iterator_to_array($topics)}
    {var $docs   = iterator_to_array((new \openvk\Web\Models\Repositories\Documents())->getDocumentsByOwner($club->getRealId())->offsetLimit(0, 6))}
    {var $followersCount = $club->getFollowersCount()}
    {var $potentialCount = $club->getPotentialFollowersCount()}
    {var $owner = $club->getOwner()}
    {var $descPlain = $club->getDescription() ?? ''}
    {var $descHtml = $club->getDescriptionHtml()}
    {var $pinnedPost = (new \openvk\Web\Models\Repositories\Posts())->getPinnedPost($club->getId() * -1)}
    {var $hasMoreInfo = false}
    {if $descPlain !== ''}
        {var $hasMoreInfo = true}
    {/if}
    {if $club->getAdministratorsListDisplay() == 0 || $club->getAdministratorsListDisplay() == 1}
        {var $hasMoreInfo = true}
    {/if}

    {include #mobileProfile, $hasMoreInfo, $albums, $audios, $topics, $followersCount, $potentialCount, $pinnedPost, $descHtml, $descPlain, $docs}

    {if $hasMoreInfo}
    <script>
    function __mobileGroupShowMore() {
        var el = document.getElementById('mobile_group_more_info_content');
        MessageBox(tr('additional_information'), el ? el.innerHTML : '', [tr('close')], [Function.noop]);
    }
    </script>
    {/if}

    <div class="wide_column_left">
        <div class="narrow_column_wrap nomobile">
            <div class="narrow_column">
			    {var $avatarPhoto = $club->getAvatarPhoto()}
    			{var $avatarLink = ((is_null($avatarPhoto) ? FALSE : $avatarPhoto->isAnonymous()) ? "/photo" . ("s/" . base_convert((string) $avatarPhoto->getId(), 10, 32)) : $club->getAvatarLink())}
				<div class="page_block photo_block">
					<div class="avatar_block" data-club="{$club->getId()}">
						<div class="avatar_block_inner">
							{if $canEdit}
								<a {if $avatarPhoto}style="display:none"{/if} class="add_image_text" id="vkify_add_image">{_add_image}</a>
								<div {if !$avatarPhoto}style="display:none"{/if} class="avatar_controls">
									<div class="avatarDelete hoverable"></div>
									<div class="avatar_variants">
										<a class="_add_image hoverable" id="vkify_add_image"><span>{_upload_new_picture}</span></a>
									</div>
								</div>
							{/if}
							{var $avatarSizes = $avatarPhoto ? $avatarPhoto->getSizes() : null}
							{var $avatarNormal = $avatarSizes['normal'] ?? null}
							{var $avatarPhotoId = $avatarPhoto ? $avatarPhoto->getPrettyId() . ($avatarPhoto->getAccessKey() ? '_' . $avatarPhoto->getAccessKey() : '') : null}
							<a href="{$avatarLink|nocheck}" style="display: block; line-height: 0;">
								{include '../components/avatar.latte', author => $club, size => 'normal', id => 'bigAvatar', width => ($avatarNormal ? $avatarNormal->width : 200), height => ($avatarNormal ? $avatarNormal->height : 200), style => 'width: 100%; image-rendering: -webkit-optimize-contrast;', onclick => ($avatarPhotoId ? "PhotoViewer.openById('{$avatarPhotoId}', event);" : null)}
							</a>
						</div>
					</div>
					<div class="profile_actions clear_fix">
						{ifset $thisUser}
							{var $subStatus = $club->getSubscriptionStatus($thisUser)}
							{var $isMaybe = $thisUser ? $club->getFollowersQuery()->where(['follower' => $thisUser->getId(), 'flags' => 1])->fetch() : null}
							{var $eventFlag = $subStatus ? ($isMaybe ? 1 : 0) : -1}
							<div class="profile_actions_split">
								{if !$subStatus}
									<form action="/setSub/club" method="post" class="profile_link_form fl_l">
										<input type="hidden" name="act" value="add" />
										<input type="hidden" name="id"  value="{$club->getId()}" />
										<input type="hidden" name="hash" value="{$csrfToken}" />
										<input type="submit" value="{if $club->isEvent()}{_ill_come_to_meeting}{else}{_join_community}{/if}" class="button button_wide" />
									</form>
								{else}
									<div class="profile_sub_wrapper ui_actions_menu_wrap ui_actions_menu_no_chevron" onclick='{="uiActionsMenu.toggle(this, null, {noAnimate: true});"|noescape}'>
										<button class="button button_wide button_gray fl_l profile_sub_btn" id="profile_sub_btn">
											{if $club->isEvent()}{if $eventFlag == 1}{_i_might_come_to_meeting}{else}{_ill_come_to_meeting}{/if}{else}{_leave_community}{/if} <span class="profile_sub_arrow"></span>
										</button>
										<div id="profile_sub_tooltip" class="ui_actions_menu" data-club-id="{$club->getId()}" data-current-flag="{$eventFlag}">
											<form style="display:none" data-action="going" action="/setSub/club" method="post">
												<input type="hidden" name="act" value="add" />
												<input type="hidden" name="flag" value="0" />
												<input type="hidden" name="id"  value="{$club->getId()}" />
												<input type="hidden" name="hash" value="{$csrfToken}" />
											</form>
											<form style="display:none" data-action="maybe" action="/setSub/club" method="post">
												<input type="hidden" name="act" value="add" />
												<input type="hidden" name="flag" value="1" />
												<input type="hidden" name="id"  value="{$club->getId()}" />
												<input type="hidden" name="hash" value="{$csrfToken}" />
											</form>
											<form style="display:none" data-action="notgoing" action="/setSub/club" method="post">
												<input type="hidden" name="act" value="rem" />
												<input type="hidden" name="id"  value="{$club->getId()}" />
												<input type="hidden" name="hash" value="{$csrfToken}" />
											</form>
											{if $club->isEvent()}
												<a href="javascript:void(0)" data-event-action="going">{_ill_come_to_meeting}</a>
												<a href="javascript:void(0)" data-event-action="maybe">{_i_might_come_to_meeting}</a>
												<a href="javascript:void(0)" data-event-action="notgoing">{_ill_not_come_to_meeting}</a>
											{else}
												<a href="javascript:void(0)" data-event-action="notgoing">{_leave_community}</a>
											{/if}
											<div class="separator"></div>
											<a n:if="!$club->isHideFromGlobalFeedEnabled()" id="__ignoreSomeone" data-val='{!$ignore_status ? 1 : 0}' data-id="{$club->getRealId()}">
												{if !$ignore_status}{_ignore_club}{else}{_unignore_club}{/if}
											</a>
										</div>
									</div>
								{/if}
								<div class="profile_more_wrapper ui_actions_menu_wrap ui_actions_menu_no_chevron" onclick='{="uiActionsMenu.toggle(this, null, {noAnimate: true});"|noescape}'>
									<button class="button button_gray profile_more_btn fl_r" id="profile_more_btn">
										{_actions}
										<span class="clear_fix">&nbsp;</span>
									</button>
									<div id="profile_actions_tooltip" class="ui_actions_menu">
											{if $canEdit}
												<a href="/club{$club->getId()}/edit">{_edit_group}</a>
												<a href="/club{$club->getId()}/stats" rel="nofollow">{_statistics}</a>
												{var $clubPinned = $thisUser->isClubPinned($club)}
												<a href="/groups_pin?club={$club->getId()}&hash={rawurlencode($csrfToken)}" n:if="$clubPinned || $thisUser->getPinnedClubCount() <= 10" id="_pinGroup" data-group-name="{$club->getName()}" data-group-url="{$club->getUrl()}">
													{if $clubPinned}
														{_remove_from_left_menu}
													{else}
														{_add_to_left_menu}
													{/if}
												</a>
												<div class="separator"></div>
											{/if}
											{if $thisUser->getChandlerUser()->can("access")->model("admin")->whichBelongsTo(NULL)}
												<a href="/admin/clubs/id{$club->getId()}">{_manage_group_action}</a>
												<a href="/admin/logs?obj_id={$club->getId()}&obj_type=Club">{_last_actions}</a>
											{/if}
											{var $canReport = $thisUser->getId() != $club->getOwner()->getId()}
											<a n:if="$canReport" href="javascript:reportClub({$club->getId()})">{_report}</a>
									</div>
								</div>
							</div>
						{else}
							<div class="guest_actions">
								{=vkifyTr('guest_actions_group', $club->getName())|noescape}
							</div>
						{/ifset}
					</div>
				</div>
				<div class="page_block" id="group_counters" n:if="$thisUser && $club->isEvent()">
					{var $fmtCount = fn($n) => $n >= 1000000 ? round($n / 1000000, 1) . 'M' : ($n >= 1000 ? round($n / 1000, 1) . 'K' : (string)$n)}
					<div class="group_counters_wrap clear_fix">
						<div class="group_counters full">
							<a class="page_counter" href="/club{$club->getId()}/followers">
								<div class="count">{$fmtCount($club->getFollowersCount())}</div>
								<div class="label">{_event_comers}</div>
							</a>
							<a class="page_counter" href="/club{$club->getId()}/followers?mightcome=1">
								<div class="count">{$fmtCount($club->getPotentialFollowersCount())}</div>
								<div class="label">{_event_potential_comers}</div>
							</a>
						</div>
					</div>
				</div>
				<div n:if="$followersCount > 0" class="page_block module people_module">

						<a href="/club{$club->getId()}/followers" class="module_header">
							<h3 class="header_top clear_fix">
								<span class="header_label fl_l">
									{_participants}
								</span>
								<span class="header_count fl_l">
									{$followersCount}
								</span>
							</h3>
						</a>
						<div class="module_body">
							<div class="search_row" n:foreach="array_chunk(array_slice(iterator_to_array($club->getFollowers(1)), 0, 6), 3) as $followerRow">
								<div class="people_cell" n:foreach="$followerRow as $follower">
									<a class="people_cell_ava" href="{$follower->getURL()}">
										{include '../components/avatar.latte', author => $follower, size => 'miniscule', width => 50, height => 50, alt => $follower->getFirstName(), class => 'people_cell_img'}
									</a>
									<div class="people_cell_name"><a href="{$follower->getURL()}">{$follower->getFirstName()}</a></div>
								</div>
							</div>
						</div>
				</div>
				<div n:if="$thisUser && $club->isEvent() && $club->getPotentialFollowersCount() > 0" class="page_block module people_module">
						<a href="/club{$club->getId()}/followers?mightcome=1" class="module_header">
							<h3 class="header_top clear_fix">
								<span class="header_label fl_l">
									{_event_potential_comers}
								</span>
								<span class="header_count fl_l">
									{$club->getPotentialFollowersCount()}
								</span>
							</h3>
						</a>
						<div class="module_body">
							<div class="search_row" n:foreach="array_chunk(array_slice(iterator_to_array($club->getPotentialFollowers(1)), 0, 6), 3) as $followerRow">
								<div class="people_cell" n:foreach="$followerRow as $follower">
									<a class="people_cell_ava" href="{$follower->getURL()}">
										{include '../components/avatar.latte', author => $follower, size => 'miniscule', width => 50, height => 50, alt => $follower->getFirstName(), class => 'people_cell_img'}
									</a>
									<div class="people_cell_name"><a href="{$follower->getURL()}">{$follower->getFirstName()}</a></div>
								</div>
							</div>
						</div>
				</div>
				<div n:ifcontent class="page_block">
					<div n:if="$albumsCount > 0 || $canEdit" class="module album_module">
						{if $albumsCount > 0}
							<a href="/albums{$club->getId() * -1}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_albums}
									</span>
									<span class="header_count fl_l">
										{$albumsCount}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="clear_fix clear page_album_row" n:foreach="array_slice(iterator_to_array($albums), 0, 3) as $album">
									<a href="/album{$album->getPrettyId()}" class="page_album_link {if is_null($album->getCoverPhoto())}page_album_nocover{/if}">
										{var $cover = $album->getCoverPhoto()}
										<div class="page_album_thumb_wrap">
											<img n:if="!is_null($cover)"
												src="{$cover->getURLBySizeId('normal')}"
												class="page_album_thumb" loading="lazy" />
										</div>
										<div class="page_album_title">
											<div class="page_album_size">{$album->getPhotosCount()}</div>
											<div class="page_album_title_text">{$album->getName()}</div>
										</div>
									</a>
								</div>
							</div>
						{elseif $canEdit}
							<a href="/albums{$club->getId() * -1}" class="page_module_upload">
								<div class="page_upload_label page_photos_upload"></div>{_upload_photo}</a>
						{/if}
					</div>

					<div n:if="($topicsCount > 0 || $club->isEveryoneCanCreateTopics() || $canEdit) && !$club->isDisplayTopicsAboveWallEnabled()" class="module topics_module">
						{if $topicsCount > 0}
							<a href="/board{$club->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_discussions}
									</span>
									<span class="header_count fl_l">
										{$topicsCount}
									</span>
								</h3>
							</a>
							<div class="module_body">
								<div class="topic_row" n:foreach="$topics as $topic">
									<div class="topic_info_wrap">
										<a href="/topic{$topic->getPrettyId()}">
											<div class="topic_icon"></div>
											<div class="topic_title">{$topic->getTitle()}</div>
										</a>
										<div class="topic_info">{tr("updated_at", $topic->getUpdateTime())}</div>
									</div>
								</div>
							</div>
						{elseif $club->isEveryoneCanCreateTopics() || $canEdit}
							<a href="/board{$club->getId()}/create" onclick="return showCreateTopicModal(event, {$club->getId()}, {$club->canBeModifiedBy($thisUser) ? 'true' : 'false'})" class="page_module_upload">
								<div class="page_upload_label page_topics_upload"></div>{_create_topic}</a>
						{/if}
					</div>

					<div n:if="$docsCount > 0 || $canEdit" class="module">
						{if $docsCount > 0}
							<a href="/docs{$club->getRealId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_documents}
									</span>
									<span class="header_count fl_l">
										{$docsCount}
									</span>
								</h3>
							</a>
							<div class="module_body">
								{foreach array_slice($docs, 0, 3) as $doc}
									{include "../Documents/components/doc.latte", doc => $doc, hideButtons => true, noTags => true}
								{/foreach}
							</div>
						{elseif $canEdit}
							<a class="page_module_upload" onclick="showDocumentUploadDialog(null, {$club->getId()})">
								<div class="page_upload_label page_docs_upload"></div>{_document_uploading_in_general}</a>
						{/if}
					</div>

					<div n:if="$audiosCount > 0 || $canEdit || $club->isEveryoneCanUploadAudios()" class="module audio_module" >
						{if $audiosCount > 0}
							<a href="/audios-{$club->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_audios}
									</span>
									<span class="header_count fl_l">
										{$audiosCount}
									</span>
								</h3>
							</a>
							<div class="module_body">
								<div class="content_list long">
									<div class="audio" n:foreach="$audios as $audio" style="width: 100%;">
										{include "../Audio/player.latte", audio => $audio, hideButtons => true}
									</div>
								</div>
							</div>
						{elseif $canEdit || $club->isEveryoneCanUploadAudios()}
							<a href="/player/upload?gid={$club->getId()}" onclick="showAudioUploadPopup({ ownerId: -{$club->getId()} }); return false;" class="page_module_upload">
								<div class="page_upload_label page_audios_upload"></div>{_add_audio_to_club}</a>
						{/if}
					</div>
				</div>

				<div n:ifcontent class="page_block">
					<div n:if="$club->getAdministratorsListDisplay() == 0" class="module page_list_module">
						<a href="/club{$club->getId()}/followers?onlyAdmins=1" class="module_header">
							<h3 class="header_top clear_fix">
								<span class="header_label fl_l">
									{_creator}
								</span>
							</h3>
						</a>

						<div class="module_body">
							<div class="line_cell clear_fix">
								{var $author = $club->getOwner()}
								<div class="thumb">
									<a href="{$author->getURL()}">
										{include '../components/avatar.latte', author => $author, size => 'miniscule', class => 'cell_img'}
									</a>
								</div>
								<div n:class="empty($club->getOwnerComment()) ? 'info' : 'desc_info'">
									<a href="{$author->getURL()}" class="people_name">{$author->getCanonicalName()}</a>
									<div n:ifcontent class="people_desc">{$club->getOwnerComment()}</div>
								</div>
							</div>
						</div>
					</div>
					<div n:if="$club->getAdministratorsListDisplay() == 1" class="module page_list_module">
						{var $managersCount = $club->getManagersCount(true)}
						<a href="/club{$club->getId()}/followers?onlyAdmins=1" class="module_header">
							<h3 class="header_top clear_fix">
								<span class="header_label fl_l">
									{_administrators}
								</span>
								<span class="header_count fl_l">
									{$managersCount}
								</span>
							</h3>
						</a>

						<div class="module_body">
							<div class="line_cell clear_fix" n:if="!$club->isOwnerHidden()">
								{var $author = $club->getOwner()}
								<div class="thumb">
									<a href="{$author->getURL()}">
										{include '../components/avatar.latte', author => $author, size => 'miniscule', class => 'cell_img'}
									</a>
								</div>
								<div n:class="empty($club->getOwnerComment()) ? 'info' : 'desc_info'">
									<a href="{$author->getURL()}" class="people_name">{$author->getCanonicalName()}</a>
									<div n:ifcontent class="people_desc">{$club->getOwnerComment()}</div>
								</div>
							</div>
							<div class="line_cell clear_fix" n:foreach="$club->getManagers(1, true) as $manager">
								{var $user = $manager->getUser()}
								<div class="thumb">
									<a href="{$user->getURL()}">
										{include '../components/avatar.latte', author => $user, size => 'miniscule', class => 'cell_img'}
									</a>
								</div>
								<div n:class="empty($manager->getComment()) ? 'info' : 'desc_info'">
									<a href="{$user->getURL()}" class="people_name">{$user->getCanonicalName()}</a>
									<div n:ifcontent class="people_desc">{$manager->getComment()}</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="wide_column_wrap">
			<div class="wide_column">
				<div n:if="!is_null($alert = $club->getAlert())" class="msg msg_yellow">{strpos($alert, "@") === 0 ? tr(substr($alert, 1)) : $alert}</div>
				<div class="page_block info_block nomobile">
					<div class="page_top">
						<h2 class="page_name">{$club->getName()}
							<a class="page_verified" n:if="$club->isVerified()" href="/verify"></a>
						</h2>
					</div>
					{if $pinnedPost}
						{var $infoTabs = [
							[
								'url' => "javascript:void(0)",
								'title' => 'pinned',
								'active' => true,
								'id' => 'group_tab_pinned'
							],
							[
								'url' => "javascript:void(0)",
								'title' => 'information',
								'active' => false,
								'id' => 'group_tab_info'
							]
						]}

						<div class="page_info_header_tabs">
							{include "../components/page_tabs_header.latte", tabs => $infoTabs, id => 'group_info_tabs', white => true}
						</div>	
					{else}
						<h2 class="page_block_h2 page_info_header_tabs">
							<ul class="ui_tabs clear_fix page_info_tabs">
								<li class="ui_tab_default"><div class="ui_tab_plain" href="/club{$club->getId()}">{_information}</div></li>
							</ul>
						</h2>	
					{/if}
					
                    <div id="group_info_content">
					<div id="group_tab_info_content" style="{if $pinnedPost}display: none;{/if}">
						<div class="page_padding info">
							<div class="group_info_block info">
								<div class="group_info_rows">
									{var $descPlain = $club->getDescription() ?? ''}
									<div class="group_info_row info">
										{if $descHtml}
											{include "../components/truncated_text.latte", html => $descHtml, plain => $descPlain, limit => 300}
										{elseif $canEdit}
											<a href="/club{$club->getId()}/edit">{_desc_none|firstUpper}</a>
										{else}
											<span class="nobold">{_desc_none|firstUpper}</span>
										{/if}
									</div>
									<div n:if="$club->getWebsite() || $canEdit" class="group_info_row site">
										{if $club->getWebsite()}
											<div class="line_value"><a n:if="$club->getWebsite()" href="{$club->getWebsite()}" rel="ugc" target="_blank">{$club->getWebsite()}</a></div>
										{elseif $canEdit}
											<a href="/club{$club->getId()}/edit">{_admin_banned_link_not_specified}</a>
										{/if}
									</div>
									{if $club->isEvent() && !is_null($club->getStartDate())}
									{var $eventStartTs = $club->getStartDate()->timestamp()}
									{var $eventFinish = $club->getFinishDate()}
									{var $fmtSameYear = "%e %h " . tr("time_at_sp") . " %R"}
									{var $fmtWithYear = "%e %B %Y " . tr("time_at_sp") . " %R"}
									<div n:class="group_info_row, $eventStartTs <= strtotime('+2 days') ? soon : time" title="{_event_start_date}">
										{$club->getStartDate()->format(date("Y", $eventStartTs) === date("Y") ? $fmtSameYear : $fmtWithYear)}{if !is_null($eventFinish)} — {$eventFinish->format(date("Y", $eventFinish->timestamp()) === date("Y") ? $fmtSameYear : $fmtWithYear)}{/if}
									</div>
									{/if}
								</div>
							</div>
						</div>
					</div>
					{if $pinnedPost}
					<div id="group_tab_pinned_content">
						<div id="underHeader">
							<div class="wall_posts content scroll_container">
								{include "../components/post.latte", post => $pinnedPost, commentSection => true, onWallOf => true}
							</div>
						</div>
					</div>
					{/if}
                    </div>
				</div>
				<div n:if="($topicsCount > 0 || $club->isEveryoneCanCreateTopics() || $canEdit) && $club->isDisplayTopicsAboveWallEnabled()"
				class="page_block module topics_module nomobile">
					{if $topicsCount > 0}
						<a href="/board{$club->getId()}" class="module_header">
							<div class="header_top clear_fix">
								<span class="header_label fl_l">
									{_discussions}
								</span>
								<span class="header_count fl_l">
									{$topicsCount}
								</span>
							</div>
						</a>
						<div class="module_body">
							<div class="topic_row" n:foreach="$topics as $topic">
								<div class="topic_info_wrap">
									<a href="/topic{$topic->getPrettyId()}">
										<div class="topic_icon"></div>
										<div class="topic_title">{$topic->getTitle()}</div>
									</a>
									<div class="topic_info">{tr("updated_at", $topic->getUpdateTime())}</div>
								</div>
							</div>
						</div>
					{elseif $club->isEveryoneCanCreateTopics() || $canEdit}
						<a href="/board{$club->getId()}/create" onclick="return showCreateTopicModal(event, {$club->getId()}, {$club->canBeModifiedBy($thisUser) ? 'true' : 'false'})" class="page_module_upload">
							<div class="page_upload_label page_topics_upload"></div>{_create_topic}</a>
					{/if}
				</div>
				{presenter "openvk!Wall->wallEmbedded", -$club->getId()}
			</div>
		</div>
	</div>
</div>

{/block}
