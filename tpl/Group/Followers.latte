{extends "../@listView.latte"}
{var $Manager = openvk\Web\Models\Entities\Manager::class}
{var $iterator = $onlyShowManagers ? $managers : $followers}
{var $count    = $paginatorConf->count}
{var $page     = $paginatorConf->page}
{var $perPage  = 6}
{var $row_class = 'group_l_row group_member_row'}
{var $canManage = $club->canBeModifiedBy($thisUser ?? null)}
{var $ownerId = $club->getOwner()->getId()}

{block title}{_followers} {$club->getCanonicalName()}{/block}

{block headIncludes}
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/groups_edit.css" data-vkify-route-style="groups_edit" />
{/block}

{block tabs}
    {include "../components/page_block_header.latte", title => $onlyShowManagers ? 'administrators' : 'followers', count => $count}
    {if $club->isEvent()}
        {var $isPotentialTab = isset($mightcome) && $mightcome === 1}
        {var $eventTabs = [
            [
                'url' => "/club{$club->getId()}/followers",
                'title' => 'event_comers',
                'active' => !$isPotentialTab
            ],
            [
                'url' => "/club{$club->getId()}/followers?mightcome=1",
                'title' => 'event_potential_comers',
                'active' => $isPotentialTab
            ]
        ]}
        {include "../components/page_tabs_header.latte", tabs => $eventTabs, id => 'events_followers_tabs', white => true}
    {/if}
{/block}

{* BEGIN ELEMENTS DESCRIPTION *}

{block narrow}
    {var $menuItems = [
        [
            'url' => "/club{$club->getId()}/edit",
            'title' => 'main',
            'active' => false,
            'condition' => $club->canBeModifiedBy($thisUser)
        ],
        [
            'url' => "/club{$club->getId()}/backdrop",
            'title' => 'backdrop_short',
            'active' => false,
            'condition' => $club->canBeModifiedBy($thisUser)
        ],
        [
            'url' => "/club{$club->getId()}/followers",
            'title' => 'followers',
            'subitems' => [
                ['url' => "/club{$club->getId()}/followers/req", 'title' => 'req', 'condition' => $club->isClosed() && $canManage, 'active' => false],
                ['url' => "/club{$club->getId()}/followers?onlyAdmins=1", 'title' => 'administrators', 'active' => $onlyShowManagers]
            ],
            'active' => !$onlyShowManagers
        ],
        [
            'url' => "/club{$club->getId()}/stats",
            'title' => 'statistics',
            'active' => false,
            'condition' => $club->canBeModifiedBy($thisUser)
        ]
    ]}
    {include "../components/ui_rmenu.latte", items => $menuItems, ownblockData => $club, additionalCssClass => 'show_as_menu_on_mobile'}
{/block}

{block link|strip|stripHtml}
    /id{$x instanceof $Manager ? $x->getUserId() : $x->getId()}
{/block}

{block preview}
    {var $avaAuthor = $x instanceof $Manager ? $x->getUser() : $x}
    <span n:class="group_u_photo, $avaAuthor->isOnline() ? online">
        {include '../components/avatar.latte', author => $avaAuthor, size => 'normal', width => 80, height => 80, alt => $avaAuthor->getCanonicalName(), class => 'group_u_photo_img'}
    </span>
{/block}

{block infotable}
    {var $user    = $x instanceof $Manager ? $x->getUser() : $x}
    {var $manager = $x instanceof $Manager ? $x : $club->getManager($user, !$canManage)}
    {var $isOwner = $ownerId === $user->getId()}
    {var $showAdministrator = $isOwner ? !$club->isOwnerHidden() || $canManage : $manager !== null}
    <div class="group_u_info">
        <a class="group_u_title" href="{$user->getURL()}">{$user->getCanonicalName()}</a>
        {var $showAge = $user->getBirthday() && $user->getBirthdayPrivacy() == 0}
        <div class="group_u_desc" n:if="$user->getCity() || $showAge">
            {$user->getCity()}{if $user->getCity() && $showAge}, {/if}{if $showAge}{tr('years', $user->getAge())}{/if}
        </div>
        <div class="group_u_info_row group_u_level" n:if="$showAdministrator">{_administrator}</div>
        {if $manager && !empty($manager->getComment()) || $isOwner && !empty($club->getOwnerComment()) && (!$club->isOwnerHidden() || $canManage)}
            <div class="group_u_desc">{if $isOwner}{$club->getOwnerComment()}{else}{$manager->getComment()}{/if}</div>
        {/if}
        <div class="group_u_info_row group_u_member_links" n:if="$canManage">
            <a href="/club{$club->getId()}/setAdmin?user={$user->getId()}&hash={rawurlencode($csrfToken)}" n:if="!$isOwner">
                {if $manager}{_devote}{else}{_promote_to_admin}{/if}
            </a>
            {if $isOwner || $manager}
                {var $hidden = $isOwner ? $club->isOwnerHidden() : $manager->isHidden()}
                <a href="/club{$club->getId()}/setAdmin?user={$user->getId()}&hidden={(int) !$hidden}&hash={rawurlencode($csrfToken)}">
                    {if $hidden}{_hidden_yes}{else}{_hidden_no}{/if}
                </a>
            {/if}
        </div>
    </div>
{/block}

{block actions}
    {var $user    = $x instanceof $Manager ? $x->getUser() : $x}
    {var $manager = $x instanceof $Manager ? $x : $club->getManager($user, !$canManage)}
    {if $canManage}
        <div class="group_u_actions">
            {var $hasActions = $manager || $ownerId === $user->getId()}
            {if $hasActions}
                <div class="ui_actions_menu_wrap" onmouseover="uiActionsMenu.show(this);" onmouseout="uiActionsMenu.hide(this);">
                    <button type="button" class="button button_gray profile_more_btn" aria-label="{_actions}">
                        <svg viewBox="0 0 8 16" width="16" height="16" fill="currentColor"><use href="#more-vertical-16"></use></svg>
                    </button>
                    <div id="followers_actions_menu_{$x->getId()}" class="ui_actions_menu">
                        {if $ownerId !== $user->getId() && $manager && $thisUser->getId() === $ownerId}
                            <a href="javascript:changeOwner({$club->getId()}, {$user->getId()}, '{$user->getCanonicalName()}')">
                                {_promote_to_owner}
                            </a>
                        {/if}
                        {if $manager}
                            <a href="javascript:setClubAdminComment('{$club->getId()}', '{$manager->getUserId()}', '{rawurlencode($csrfToken)}')">{_set_comment}</a>
                        {/if}
                        <a n:if="$ownerId === $user->getId()" href="javascript:setClubAdminComment('{$club->getId()}', '{$ownerId}', '{rawurlencode($csrfToken)}')">{_set_comment}</a>
                    </div>
                </div>
            {/if}
        </div>
    {/if}
{/block}