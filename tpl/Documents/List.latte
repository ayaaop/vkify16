{extends "../@layout.latte"}

{block title}
    {if !isset($group)}
        {_my_documents_objectively}
    {else}
        {_documents_of_group}
    {/if}
{/block}

{block content}
    {var $is_gallery = $current_tab == 3 || $current_tab == 4}
    <div class="wide_column_left">
    <div class="narrow_column_wrap">
        <div class="narrow_column">
            {var $tabMenuItems = [
                [
                    'url' => '?tab=0',
                    'title' => 'document_type_0',
                    'active' => $current_tab == 0,
                    'count' => null
                ]
            ]}
            {foreach $tabs as $tab}
                {var $tabMenuItems[] = [
                    'url' => '?tab=' . $tab['type'],
                    'title' => $tab['name'],
                    'translate' => false,
                    'active' => $tab['type'] == $current_tab,
                    'count' => $tab['count'] > 1 ? $tab['count'] : null
                ]}
            {/foreach}
            {if !$is_gallery && sizeof($tags) > 0}
                {var $tabMenuItems[] = [
                    'isSeparator' => true
                ]}
                {var $tabMenuItems[] = [
                    'url' => '/search?section=docs',
                    'title' => 'documents_all',
                    'translate' => true,
                    'active' => false,
                    'count' => null
                ]}
                {foreach $tags as $tag}
                    {var $tabMenuItems[] = [
                        'url' => '/search?section=docs&tags=' . urlencode($tag),
                        'title' => $tag,
                        'translate' => false,
                        'active' => false,
                        'count' => null
                    ]}
                {/foreach}
            {/if}
            {include "../components/ui_rmenu.latte", items => $tabMenuItems, additionalCssClass => 'docs_tabs', id => 'docs_tabs', ownblockData => isset($group) ? $group : null}
            <div n:if="$count > 3" class="page_block module_body">
                    <select name="docs_sort">
                        <option n:attr="selected => $order == 0" value="0">{_documents_sort_add}</option>
                        <option n:attr="selected => $order == 1" value="1">{_documents_sort_alphabet}</option>
                        <option n:attr="selected => $order == 2" value="2">{_documents_sort_size}</option>
                    </select>
            </div>
        </div>
    </div>
    <div class="wide_column_wrap">
        <div class="wide_column">
            {capture $uploadBtnExtra}
                {if $canUpload}
                    <input onclick='onUploadEntryPointClick(event)' id='upload_entry_point' class='button' type='button' value='{_upload_button}' {if isset($group)}data-gid='{$group->getId()}'{/if}>
                {/if}
            {/capture}
            <div class="page_block">
                {include "../components/page_block_header.latte", title => "documents", extra => $uploadBtnExtra}
                <div class="list_view">
                <div n:class="docs_page_content, $is_gallery ? docs_page_gallery">
                    <div>
                        <div n:class="container_white, scroll_container">
                            {if $count > 0}
                                {foreach $docs as $doc}
                                    {if $is_gallery}
                                        {include "components/image.latte", doc => $doc, scroll_context => true, club => isset($group) ? $group : NULL}
                                    {else}
                                        {include "components/doc.latte", doc => $doc, scroll_context => true, club => isset($group) ? $group : NULL}
                                    {/if}
                                {/foreach}
                            {else}
                                {include "../components/content_error.latte", description => tr("there_is_no_documents_alright")}
                            {/if}
                        </div>

                    </div>
                    {include "../components/paginator.latte", conf => $paginatorConf}
                </div>
                </div>
            </div>
        </div>
    </div>
{/block}