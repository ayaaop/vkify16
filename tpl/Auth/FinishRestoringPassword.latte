{extends "../@layout.latte"}

{block title}
    {_access_recovery}
{/block}

{block headIncludes}
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/settings.css" data-vkify-route-style="settings" />
{/block}

{block content}
    <div class="page_block">
        {include "../components/page_block_header.latte" title: "page_access_recovery"}
        <div class="settings_block_msg">
                {_access_recovery_info_2}
        </div>
        <div class="form_group clear_fix label_end settings_padding">
            <form method="POST" enctype="multipart/form-data">
                <div class="form_field">
                    <div class="form_label">{_new_password}</div>
                    <div class="form_data">
                        <input class="text long-field" id="password" type="password" name="password" required />
                    </div>
                </div>
                {if $is2faEnabled}
                <div class="form_field">
                    <div class="form_label">{_"2fa_code_2"}</div>
                    <div class="form_data">
                        <input class="text long-field" id="code2fa" type="text" name="code2fa" required />
                    </div>
                </div>
                {/if}
                <div class="form_field">
                    <div class="form_label"></div>
                    <div class="form_data">
                        <input type="hidden" name="hash" value="{$csrfToken}" />
                        <input type="submit" value="{_reset_password}" class="button" />
                    </div>
                </div>
            </form>
        </div>
    </div>
{/block}
