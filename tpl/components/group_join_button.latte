{if !$club->isPrivate()}
    {var $requestSent = $club->isClosed() && $club->isJoinRequestSent($thisUser)}
    <form action="/setSub/club" method="post" class="{$formClass}">
        <input type="hidden" name="act" value="{$requestSent ? 'rem' : 'add'}" />
        <input type="hidden" name="id" value="{$club->getId()}" />
        <input type="hidden" name="hash" value="{$csrfToken}" />
        <input type="submit" class="{$buttonClass}" value="{if $club->isClosed()}{if $requestSent}{_clubs_cancel_request}{else}{_clubs_sumbit_request}{/if}{elseif $club->isEvent()}{_ill_come_to_meeting}{else}{_join_community}{/if}" />
    </form>
{/if}
