{php if (!function_exists('vkifyTr')) require_once \OPENVK_ROOT . '/themepacks/vkify16/res/php/vkify_i18n.php';}
{php if(!isset($GLOBALS["textAreaCtr"])) $GLOBALS["textAreaCtr"] = 10;}
{php $textAreaId = ($post ?? NULL) === NULL ? (++$GLOBALS["textAreaCtr"]) : $post->getId()}
{var $textAreaId = ($custom_id ?? NULL) === NULL ? $textAreaId : $custom_id}

{var $attachMenuInTooltip = $attachMenuInTooltip ?? false}
{var $isPostComposer = $postOpts ?? true}
{var $docsEnabled = $docs ?? true}
{var $notesEnabled = ($notes ?? false) === true}
{var $graffitiEnabled = ($graffiti ?? false) === true}
{var $pollsEnabled = ($polls ?? false) === true}
{var $geoEnabled = ($geo ?? false) === true}
{var $sourceEnabled = $hasSource ?? false}

{var $anonEnabled = \OPENVK_ROOT_CONF['openvk']['preferences']['wall']['anonymousPosting']['enable']}
{var $anonAccountId = \OPENVK_ROOT_CONF['openvk']['preferences']['wall']['anonymousPosting']['account'] ?? 100}
{var $anonUser = $anonEnabled ? (new \openvk\Web\Models\Repositories\Users())->get($anonAccountId) : NULL}

{var $hasClub = !is_null($club ?? NULL)}
{var $canModifyClub = $hasClub && !is_null($thisUser ?? NULL) && $club->canBeModifiedBy($thisUser)}
{var $clubDataId = $canModifyClub ? $club->getId() : null}
{var $clubDataRealId = $canModifyClub ? $club->getRealId() : null}
{var $showGroupPostOpts = $isPostComposer && $canModifyClub && ($owner ?? 0) < 0}
{var $showCommentAsGroup = !$isPostComposer && $canModifyClub}
{var $anonHide = $showGroupPostOpts}

<div id="write" class="composer has_emoji_picker model_content_textarea">
    <form id="write-form-{$textAreaId}" action="{$route}" method="post" enctype="multipart/form-data" style="margin:0;">
        {if $thisUser ?? NULL}
            <a class="post_field_user_link" href="{$showGroupPostOpts ? $club->getURL() : $thisUser->getURL()}">
                {include 'avatar.latte',
                    author => $thisUser,
                    size => 'miniscule',
                    class => 'post_field_user_image',
                    width => 28,
                    height => 28,
                    alt => $thisUser->getCanonicalName(),
                    style => $showGroupPostOpts ? 'opacity: 0;' : null,
                    data => ['user-url' => $thisUser->getURL()]}

                {if $hasClub}
                    {include 'avatar.latte',
                        author => $club,
                        size => 'miniscule',
                        class => 'post_field_user_image post_field_user_image_group',
                        width => 28,
                        height => 28,
                        alt => $club->getCanonicalName(),
                        style => $showGroupPostOpts ? 'opacity: 1;' : 'opacity: 0;',
                        data => ['group-url' => $club->getURL()]}
                {/if}

                {if $anonEnabled && $isPostComposer && $anonUser}
                    {include 'avatar.latte',
                        author => $anonUser,
                        size => 'miniscule',
                        class => 'post_field_user_image post_field_user_image_anon',
                        width => 28,
                        height => 28,
                        alt => $anonUser->getCanonicalName(),
                        style => 'opacity: 0;',
                        data => ['anon-url' => $anonUser->getURL()]}
                {/if}
            </a>
        {/if}

        <div class="textareas">
            {include "content-editable.latte",
                id => "wall-post-input" . $textAreaId,
                name => "text",
                placeholder => ($placeholder ?? tr("write")),
                class => "small-textarea",
                style => "resize: none;"
            }
            <div class="emoji_picker_entrypoint emoji_smile" role="button" n:attr="data-stickers => $isPostComposer ? '0' : null">
                <div class="emoji_smile_icon_vector emoji_smile_icon"></div>
            </div>
        </div>

        <div id="post-buttons{$textAreaId}" class="post-buttons">
            <div class="post-horizontal{if !$isPostComposer} post-horizontal--comment{/if}"></div>
            <div class="post-vertical"></div>
            <div class="post-has-poll">{_poll}</div>
            <div class="post-has-geo"></div>
            <div class="post-source"></div>

            <input type="hidden" name="horizontal_attachments" value="" autocomplete="off" />
            <input type="hidden" name="vertical_attachments" value="" autocomplete="off" />
            <input type="hidden" name="poll" value="none" autocomplete="off" />
            <input type="hidden" id="source" name="source" value="none" autocomplete="off" />
            <input type="hidden" name="geo" value="" autocomplete="off" />
            <input type="hidden" name="reply_to_comment" value="" autocomplete="off" />
            <input type="hidden" name="type" value="1" autocomplete="off" />
            <input type="hidden" name="hash" value="{$csrfToken}" />

            <div class="post-bottom-acts">
                <div id="wallAttachmentMenu" class="page_add_media post-attach-menu {if !$attachMenuInTooltip}post-attach-menu--inline{/if}">
                    {if $attachMenuInTooltip}
                        <div class="ui_actions_menu_wrap" onmouseover="{='uiActionsMenu.show(this, null, {align: ""});'|noescape}" onmouseout="uiActionsMenu.hide(this);">
                            <span
                                class="post-attach-menu__trigger"
                                id="moreAttachTrigger{$textAreaId}"
                                tabindex="0"
                                role="button"
                            ></span>
                            <div class="ui_actions_menu" id="moreAttachTooltip{$textAreaId}">
                            <a id="__photoAttachment" class="attach_photo" n:attr="data-club => $clubDataId">
                                <div class="post-attach-menu__icon"><svg width="16" height="13" viewBox="0 0 16 13"><use href="#menu-my-photos"/></svg></div>
                                {_photo}
                            </a>
                            <a id="__videoAttachment" class="attach_video" n:attr="data-club => $clubDataId">
                                <div class="post-attach-menu__icon"><svg width="14" height="14" viewBox="0 0 14 14"><use href="#menu-my-videos"/></svg></div>
                                {_video}
                            </a>
                            <a id="__audioAttachment" class="attach_audio" n:attr="data-club => $clubDataId">
                                <div class="post-attach-menu__icon"><svg width="13" height="16" viewBox="0 0 12.94 16.02"><use href="#menu-my-audios"/></svg></div>
                                {_audio}
                            </a>
                            <a n:if="$docsEnabled" id="__documentAttachment" class="attach_document" n:attr="data-club => $clubDataRealId">
                                <div class="post-attach-menu__icon"><svg width="12" height="14" viewBox="0 0 12 14"><use href="#menu-my-docs"/></svg></div>
                                {_document}
                            </a>
                            {if $isPostComposer}
                                <a n:if="$notesEnabled" id="__notesAttachment" class="attach_note">
                                    <div class="post-attach-menu__icon"><svg width="12" height="14" viewBox="0 0 12 14"><use href="#menu-my-notes"/></svg></div>
                                    {_note}
                                </a>
                                <a n:if="$graffitiEnabled" class="attach_graffiti" onclick="window.vkifyGraffiti(event);">
                                    <div class="post-attach-menu__icon"><svg width="18" height="18" viewBox="0 0 32 32"><use href="#graffiti-32"/></svg></div>
                                    {_graffiti}
                                </a>
                                <a n:if="$pollsEnabled" class="attach_poll" onclick="initPoll(event);">
                                    <div class="post-attach-menu__icon"><svg width="13" height="13" viewBox="0 0 13 13"><use href="#menu-poll"/></svg></div>
                                    {_poll}
                                </a>
                                <a n:if="$geoEnabled" id="__geoAttacher" class="attach_geo">
                                    <div class="post-attach-menu__icon"><svg width="13" height="17" viewBox="0 0 13 17"><use href="#attach-geo"/></svg></div>
                                    {_geo_place}
                                </a>
                            {/if}
                        </div>
                        </div>
                    {elseif $isPostComposer}
                        <a id="__photoAttachment" class="attach_photo"
                           data-title="{_photo}" aria-label="{_photo}" role="button" onmouseover="showTitle(this)"
                           n:attr="data-club => $clubDataId">
                            <div class="post-attach-menu__icon"><svg width="16" height="13" viewBox="0 0 16 13"><use href="#menu-my-photos"/></svg></div>
                        </a>
                        <a id="__videoAttachment" class="attach_video"
                           data-title="{_video}" aria-label="{_video}" role="button" onmouseover="showTitle(this)"
                           n:attr="data-club => $clubDataId">
                            <div class="post-attach-menu__icon"><svg width="14" height="14" viewBox="0 0 14 14"><use href="#menu-my-videos"/></svg></div>
                        </a>
                        <a id="__audioAttachment" class="attach_audio"
                           data-title="{_audio}" aria-label="{_audio}" role="button" onmouseover="showTitle(this)"
                           n:attr="data-club => $clubDataId">
                            <div class="post-attach-menu__icon"><svg width="13" height="16" viewBox="0 0 12.94 16.02"><use href="#menu-my-audios"/></svg></div>
                        </a>
                        <div class="ui_actions_menu_wrap" onmouseover="{='uiActionsMenu.show(this, null, {align: "center"});'|noescape}" onmouseout="uiActionsMenu.hide(this);">
                            <a class="post-attach-menu__trigger" id="moreAttachTrigger{$textAreaId}">
                                {=vkifyTr('more')}
                            </a>
                            <div class="ui_actions_menu" id="moreAttachTooltip{$textAreaId}">
                                <a n:if="$docsEnabled" id="__documentAttachment" class="attach_document" n:attr="data-club => $clubDataRealId">
                                    <div class="post-attach-menu__icon"><svg width="12" height="14" viewBox="0 0 12 14"><use href="#menu-my-docs"/></svg></div>
                                    {_document}
                                </a>
                                <a n:if="$notesEnabled" id="__notesAttachment" class="attach_note">
                                    <div class="post-attach-menu__icon"><svg width="12" height="14" viewBox="0 0 12 14"><use href="#menu-my-notes"/></svg></div>
                                    {_note}
                                </a>
                                <a n:if="$graffitiEnabled" class="attach_graffiti" onclick="window.vkifyGraffiti(event);">
                                    <div class="post-attach-menu__icon"><svg width="18" height="18" viewBox="0 0 32 32"><use href="#graffiti-32"/></svg></div>
                                    {_graffiti}
                                </a>
                                <a n:if="$pollsEnabled" class="attach_poll" onclick="initPoll(event);">
                                    <div class="post-attach-menu__icon"><svg width="13" height="13" viewBox="0 0 13 13"><use href="#menu-poll"/></svg></div>
                                    {_poll}
                                </a>
                                <a n:if="$geoEnabled" id="__geoAttacher" class="attach_geo">
                                    <div class="post-attach-menu__icon"><svg width="13" height="17" viewBox="0 0 13 17"><use href="#attach-geo"/></svg></div>
                                    {_geo_place}
                                </a>
                            </div>
                        </div>
                    {else}
                        <a id="__photoAttachment" class="attach_photo"
                           data-title="{_photo}" aria-label="{_photo}" role="button" onmouseover="showTitle(this)"
                           n:attr="data-club => $clubDataId">
                            <div class="post-attach-menu__icon"><svg width="16" height="13" viewBox="0 0 16 13"><use href="#menu-my-photos"/></svg></div>
                        </a>
                        <a id="__videoAttachment" class="attach_video"
                           data-title="{_video}" aria-label="{_video}" role="button" onmouseover="showTitle(this)"
                           n:attr="data-club => $clubDataId">
                            <div class="post-attach-menu__icon"><svg width="14" height="14" viewBox="0 0 14 14"><use href="#menu-my-videos"/></svg></div>
                        </a>
                        <a id="__audioAttachment" class="attach_audio"
                           data-title="{_audio}" aria-label="{_audio}" role="button" onmouseover="showTitle(this)"
                           n:attr="data-club => $clubDataId">
                            <div class="post-attach-menu__icon"><svg width="13" height="16" viewBox="0 0 12.94 16.02"><use href="#menu-my-audios"/></svg></div>
                        </a>
                        <a n:if="$docsEnabled" id="__documentAttachment" class="attach_document"
                           data-title="{_document}" aria-label="{_document}" role="button" onmouseover="showTitle(this)"
                           n:attr="data-club => $clubDataRealId">
                            <div class="post-attach-menu__icon"><svg width="12" height="14" viewBox="0 0 12 14"><use href="#menu-my-docs"/></svg></div>
                        </a>
                    {/if}
                    {if $showCommentAsGroup}
                        <div class="post-opts-trigger ui_actions_menu_wrap" onmouseover="{='uiActionsMenu.show(this, null, {align: "left"});'|noescape}" onmouseout="uiActionsMenu.hide(this);">
                            <div class="post_settings" id="postOptsTrigger{$textAreaId}" role="button">
                                <div class="common_icon"></div>
                            </div>
                            <div class="post-opts ui_actions_menu" id="postOptsTooltip{$textAreaId}">
                                <label class="checkbox">
                                    <input type="checkbox" name="as_group" form="write-form-{$textAreaId}" onchange="window.handleWallAsGroupClick(this)" />
                                    <span>{_comment_as_group}</span>
                                </label>
                            </div>
                        </div>
                    {/if}
                </div>

                <div class="post-replyto" n:if="!$attachMenuInTooltip"></div>

                <div class="post-bottom-buttons">
                    {if $isPostComposer}
                        <div class="ui_actions_menu_wrap" onmouseover="{='uiActionsMenu.show(this);'|noescape}" onmouseout="uiActionsMenu.hide(this);">
                            <div class="post_settings" id="postOptsTrigger{$textAreaId}" role="button">
                                <div class="common_icon"></div>
                            </div>
                            <div class="post-opts ui_actions_menu" id="postOptsTooltip{$textAreaId}">
                            {if $showGroupPostOpts}
                                <input type="hidden" name="as_group" value="on" form="write-form-{$textAreaId}" />
                                <label class="checkbox" id="forceSignOpt">
                                    <input type="checkbox" name="force_sign" form="write-form-{$textAreaId}" />
                                    <span>{_add_signature}</span>
                                </label>
                            {/if}

                            <label n:if="$anonEnabled" class="checkbox" id="octoberAnonOpt" n:attr="style => $anonHide ? 'display: none;' : null">
                                <input type="checkbox" name="anon" form="write-form-{$textAreaId}" onchange="window.handleWallAnonClick(this)" />
                                <span>{_as_anonymous}</span>
                            </label>

                            <label class="checkbox">
                                <input type="checkbox" name="nsfw" form="write-form-{$textAreaId}" />
                                <span>{_contains_nsfw}</span>
                            </label>

                            {if $sourceEnabled}
                                <div class="separator"></div>
                                <a id="__sourceAttacher" class="attach_source">
                                    <div class="post-attach-menu__icon"></div>
                                    {_set_source}
                                </a>
                            {/if}
                        </div>
                        </div>
                    {/if}

                    {if !$isPostComposer}
                        <input type="button" value="{_cancel}" class="button button_light wall-comment-cancel" />
                    {/if}

                    <input type="submit" value="{if $isPostComposer}{_publish}{else}{_send}{/if}" class="button" />
                </div>
            </div>
            <div class="post-replyto" n:if="$attachMenuInTooltip"></div>
        </div>
    </form>
</div>
