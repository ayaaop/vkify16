<div class="mobile-profile-hero mobileonly">
    {var $avPhoto = $entity->getAvatarPhoto()}
    {var $avOnclick = $avPhoto && !($disablePhotoViewer ?? false) ? "PhotoViewer.openById('" . $avPhoto->getPrettyId() . ($avPhoto->getAccessKey() ? '_' . $avPhoto->getAccessKey() : '') . "', event);" : null}
    <div class="mobile-hero-img-wrap{if $avPhoto} has-avatar-photo{/if}" onclick="{$avOnclick|noescape}">
        {include '../components/avatar.latte', author => $entity, size => 'large', class => 'mobile-hero-img', width => false, height => false, alt => ($alt ?? $name)}
        <div class="mobile-hero-gradient"></div>
        <div class="mobile-hero-info">
            <h2 class="mobile-hero-name">{$name} <a class="page_verified" n:if="$verified" href="/verify"></a></h2>
            <div class="mobile-hero-status">{$status}</div>
        </div>
    </div>
</div>
