{extends "../@layout.latte"}
{block title}{_select_language}{/block}

{block headIncludes}
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/settings.css" data-vkify-route-style="settings" />
{/block}

{block content}
    <div class="page_block">
        {include "../components/page_block_header.latte" title => 'select_language'}
        <div class="page_padding">
            <div class="languages_list clear_fix" id="all_languages_list">
                {for $col = 0; $col < 4; $col++}
                    <div class="language_column fl_l">
                        {foreach $languages as $index => $language}
                            {if $index % 4 === $col}
                                <div>
                                    <a href="/language?lg={$language['code']}&hash={urlencode($csrfToken)}" 
                                    n:class="language_title, $language['code'] === getLanguage() ? language_selected"
                                    data-tip="simple-black" 
                                    data-tiptitle="{$language['name']}"
                                    data-align="top-start">
                                        {$language['native_name']}
                                    </a>
                                </div>
                            {/if}
                        {/foreach}
                    </div>
                {/for}
            </div>
        </div>
        <div class="page_block_footer">
            <a href="https://hosted.weblate.org/projects/openvk/" target="_blank">{_language_add_strings}</a>
        </div>
    </div>
{/block}
