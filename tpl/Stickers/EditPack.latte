{extends "../@layout.latte"}

{block title}
    {if $isNew}{_stickers_new_pack}{else}{_stickers_edit_pack}{/if}
{/block}

{block headIncludes}
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/settings.css" data-vkify-route-style="settings" />
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/sticker-editor.css" data-vkify-route-style="sticker-editor" />
    {if !$isNew && $pack}
        <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/graph.css" data-vkify-route-style="graph" />
    {/if}
{/block}

{block content}
    <div class="wide_column_left">
        <div class="narrow_column_wrap">
            <div class="narrow_column">
                {include "Tabs.latte", act => 'author'}
            </div>
        </div>
        <div class="wide_column_wrap">
            <div class="wide_column">
                <form id="packForm" class="sticker_editor" data-sticker-editor data-is-new="{if $isNew}true{else}false{/if}"
                      data-withdraw-tax="{floatval($withdrawTax ?? 0)}" data-pack-id="{$pack ? $pack->getId() : 0}" data-balance="{$pack ? $pack->getBalance() : 0}"
                      method="POST" enctype="multipart/form-data" action="{if $isNew}/stickers/new{else}/stickers/edit/{$pack->getId()}{/if}">
                    <input type="hidden" name="hash" value="{$csrfToken}" />
                    <div class="page_block">
                        {include "../components/page_block_header.latte", title => $isNew ? 'stickers_new_pack' : 'stickers_edit_pack'}
                        {if !$isNew && $pack}
                            <div class="settings_block_msg">
                                {_stickers_pack_balance}: <b>{tr('coins', (int) round($pack->getBalance()))}</b>
                                {if $pack->getBalance() > 0}
                                    (<button type="button" class="sticker_editor_link" data-sticker-action="withdraw">{_stickers_withdrawal_q}</button>)
                                {/if}
                            </div>
                        {/if}
                        <div class="form_group settings_padding clear_fix label_end">
                            <div class="form_field">
                                <label class="form_label" for="pack_name">{_stickers_pack_name}</label>
                                <div class="form_data">
                                    <input type="text" name="name" id="pack_name" value="{$pack ? $pack->getName() : ''}" required />
                                </div>
                            </div>
                            <div class="form_field">
                                <label class="form_label" for="pack_slug">{_stickers_pack_slug}</label>
                                <div class="form_data">
                                    <input type="text" name="slug" id="pack_slug" value="{$pack ? $pack->getSlug() : ''}" placeholder="my-pack-name" />
                                </div>
                            </div>
                            <div class="form_field">
                                <label class="form_label" for="pack_description">{_stickers_pack_desc}</label>
                                <div class="form_data">
                                    <textarea name="description" id="pack_description" class="small-textarea">{$pack ? $pack->getDescription() : ''}</textarea>
                                </div>
                            </div>
                            <div class="form_field">
                                <label class="form_label" for="pack_price">{_stickers_pack_price}</label>
                                <div class="form_data">
                                    <input type="number" name="price" id="pack_price" min="0" value="{$pack ? $pack->getPrice() : 0}" />
                                </div>
                            </div>
                            <div class="form_field">
                                <label class="form_label" for="pack_author">{_stickers_pack_author}</label>
                                <div class="form_data">
                                    <input type="text" name="author" id="pack_author" value="{$pack ? $pack->getAuthor() : ''}" placeholder="{_stickers_pack_author_placeholder}" />
                                </div>
                            </div>
                            <div class="form_field">
                                <label class="form_label" for="pack_author_url">{_stickers_pack_author_url}</label>
                                <div class="form_data">
                                    <input type="url" name="author_url" id="pack_author_url" value="{$pack ? $pack->getAuthorUrl() : ''}" placeholder="https://example.com/..." />
                                </div>
                            </div>
                            <div class="form_field sticker_editor_visibility">
                                <div class="form_data">
                                    <label class="checkbox">
                                        <input type="checkbox" name="unlisted" value="1" {if $pack && $pack->isUnlisted()}checked{/if} />
                                        <span>{_stickers_pack_unlisted}</span>
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>
                    {if !$isNew && $pack}
                        <div class="page_block stickers_edit_page">
                        {include "../components/page_block_header.latte", title => 'stickers_install_stats'}
                            <div class="stickers_stats_wrapper">
                                <div class="stickers_stats_header">
                                    <div class="stickers_stats_title_row">
                                        <div class="stickers_period_switcher" id="stickerPeriodSwitcher">
                                            <button type="button" class="stickers_period_link active" data-period="14" aria-pressed="true">{_stickers_period_14d}</button>
                                            <button type="button" class="stickers_period_link" data-period="30" aria-pressed="false">{_stickers_period_30d}</button>
                                            <button type="button" class="stickers_period_link" data-period="90" aria-pressed="false">{_stickers_period_90d}</button>
                                        </div>
                                    </div>
                                    <div class="stickers_stats_total">
                                        {_stickers_total_installs}: <b>{$totalInstalls}</b>
                                    </div>
                                </div>
                                <div id="stickerInstallsChart" class="stickers_chart_container" aria-label="{_stickers_install_stats}" data-sticker-stats="{json_encode($installStats)}"></div>
                            </div>
                        </div>
                    {/if}
                    {if !$isNew && $pack && sizeof($existingStickers) > 0}
                        <div class="page_block">
                            {include "../components/page_block_header.latte", title => 'stickers_gift_box_title'}
                            <div class="sticker_editor_content">
                                <p class="sticker_editor_hint">{_stickers_gift_box_hint}</p>
                                <div class="stickers_gift_preview_block">
                                    <div class="stickers_gift_preview_thumb_wrap">
                                        {if $gift}
                                            <img src="{$gift->getImage(2)}" alt="{_stickers_gift_box_title}" class="stickers_gift_preview_img" />
                                        {elseif $pack->getMainSticker()}
                                            <img src="{$pack->getMainSticker()->getImageUrl(256)}" alt="{_stickers_gift_box_title}" class="stickers_gift_preview_img" />
                                        {else}
                                            <div class="stickers_modal_cover_placeholder"></div>
                                        {/if}
                                    </div>
                                    <div class="stickers_gift_preview_info">
                                        <div class="stickers_gift_preview_slots_title"><b>{_stickers_gift_composition}:</b></div>
                                        <div class="stickers_gift_preview_slot_item">
                                            <span>{_stickers_gift_front_slot}</span>
                                            <strong id="gift_front_sticker_name"></strong>
                                        </div>
                                        <div class="stickers_gift_preview_slot_item">
                                            <span>{_stickers_gift_back_slots}:</span>
                                            <span id="gift_selected_count">{sizeof($giftStickerIds ?? [])} / 3</span>
                                        </div>
                                        <p class="stickers_gift_preview_note">{_stickers_gift_save_note}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {/if}
                    <div class="page_block">
                        {include "../components/page_block_header.latte", title => 'stickers_upload_title'}
                        <div class="docs_choose_upload_area_wrap" data-sticker-dropzone>
                            <input type="file" id="stickers_file_input" name="stickers[]" multiple accept="image/png,image/jpeg,image/webp,image/gif,.json,.tgs" hidden />
                            <button type="button" class="docs_choose_upload_area" data-sticker-action="upload" aria-describedby="sticker_upload_hint">
                                <span class="docs_choose_upload_area_label">{_stickers_select_files}</span>
                            </button>
                        </div>
                        <div class="sticker_editor_content">
                            <p class="sticker_editor_hint" id="sticker_upload_hint">{_stickers_upload_hint}</p>
                            <div class="msg error" role="alert" data-sticker-upload-error hidden>{=vkifyTr('stickers_upload_invalid')}</div>
                            <section data-sticker-pending hidden>
                                <h3 class="sticker_editor_section_header">{=vkifyTr('stickers_pending')} <span id="draft_counter" aria-live="polite"></span></h3>
                                <div id="drafts_container" class="sticker_editor_items"></div>
                            </section>
                            <template data-sticker-draft>
                                <article class="sticker_editor_item draft_sticker_card" data-sticker-card>
                                    <div class="sticker_editor_item_preview">
                                        <div class="sticker_editor_item_thumb" data-sticker-thumb></div>
                                        <div class="photos_edit_actions">
                                            <button type="button" data-sticker-action="remove" title="{_stickers_delete_sticker}" aria-label="{_stickers_delete_sticker}">
                                                <span class="icon photos_action_delete" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="sticker_editor_item_fields">
                                        <div class="sticker_editor_filename" data-sticker-filename></div>
                                        <div class="emoji-input-wrap">
                                            <div class="content-editable-wrap">
                                                <textarea name="emojis[]" class="content-editable-fallback sticker-emoji-input" rows="1"
                                                          placeholder="{_stickers_emoji_placeholder}" aria-label="{_stickers_emoji_placeholder}"
                                                          data-submit-on-enter="false" data-single-line="true"></textarea>
                                            </div>
                                            <div class="emoji_picker_entrypoint" title="{_stickers_emoji_placeholder}"></div>
                                        </div>
                                        <label class="radio">
                                            <input type="radio" data-sticker-cover />
                                            <span>{_stickers_cover}</span>
                                        </label>
                                    </div>
                                </article>
                            </template>
                            {if !$isNew && sizeof($existingStickers) > 0}
                                <h3 class="sticker_editor_section_header">
                                    <span>{=vkifyTr('stickers_existing')} ({sizeof($existingStickers)})</span>
                                    <span class="sticker_editor_gift_count">{_stickers_gift_bg_sticker}: <output data-sticker-gift-count aria-live="polite">{sizeof($giftStickerIds ?? [])} / 3</output></span>
                                </h3>
                                <div class="sticker_editor_items">
                                    {foreach $existingStickers as $stk}
                                        <div class="sticker_editor_item existing_sticker_card" id="stk_card_{$stk->getId()}" data-sticker-card>
                                            <div class="sticker_editor_item_preview">
                                                <div class="sticker_editor_item_thumb">
                                                    <img src="{$stk->getImageUrl(128)}" width="128" height="128" alt="" />
                                                </div>
                                                <div class="photos_edit_actions">
                                                    <label title="{_stickers_delete_sticker}">
                                                        <input type="checkbox" name="delete_stickers[]" value="{$stk->getId()}" data-sticker-delete aria-label="{_stickers_delete_sticker}" />
                                                        <span class="icon photos_action_delete" aria-hidden="true"></span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="sticker_editor_item_fields">
                                                <div class="emoji-input-wrap">
                                                    <div class="content-editable-wrap">
                                                        <textarea name="existing_emojis[{$stk->getId()}]"
                                                                class="content-editable-fallback sticker-emoji-input"
                                                                placeholder="{_stickers_emoji_placeholder}"
                                                                aria-label="{_stickers_emoji_placeholder}"
                                                                data-submit-on-enter="false"
                                                                data-single-line="true"
                                                                rows="1">{$stk->getEmoji()}</textarea>
                                                    </div>
                                                    <div class="emoji_picker_entrypoint" title="{_stickers_emoji_placeholder}"></div>
                                                </div>
                                                <label class="radio">
                                                    <input type="radio" name="main_sticker_id" id="sticker_cover_{$stk->getId()}" data-sticker-cover value="{$stk->getId()}" {if $pack->getMainSticker() && $pack->getMainSticker()->getId() === $stk->getId()}checked{/if} />
                                                    <span>{_stickers_cover}</span>
                                                </label>
                                                <label class="checkbox">
                                                    <input type="checkbox" name="gift_stickers[]" value="{$stk->getId()}" class="sticker-gift-checkbox" {if in_array($stk->getId(), $giftStickerIds ?? [], true)}checked{/if} />
                                                    <span>{_stickers_gift_bg_sticker}</span>
                                                </label>
                                            </div>
                                            <div class="photos_restore" data-sticker-restore hidden>
                                                <p data-sticker-delete-status role="status">{=vkifyTr('stickers_delete_pending')}</p>
                                                <button type="button" class="sticker_editor_link" data-sticker-action="restore">{_restore}</button>
                                            </div>
                                        </div>
                                    {/foreach}
                                </div>
                            {/if}
                        </div>
                    </div>
                    <div class="_photos_save_changes">
                        <button type="submit" class="button">{if $isNew}{_stickers_save_pack}{else}{_save}{/if}</button>
                        <button n:if="!$isNew" type="button" class="sticker_editor_link" data-sticker-action="delete">{_stickers_delete_pack}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{/block}
