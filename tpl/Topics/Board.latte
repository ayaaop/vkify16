{extends "../@layout.latte"}
{var $topics = iterator_to_array($topics)}
{var $page     = $paginatorConf->page}
{var $canModify = $club->canBeModifiedBy($thisUser)}

{block title}{_discussions} {$club->getCanonicalName()}{/block}

{block content}
    {var $extraActions = ''}
    {if $canModify}
        {var $extraActions = $extraActions . '<a class="button button_gray" href="javascript:void(0)" onclick="createChatTopic('.$club->getId().'); return false;">'.tr('create_topic_as_chat').'</a> '}
    {/if}
    {if $club->isEveryoneCanCreateTopics() || $canModify}
        {var $extraActions = $extraActions . '<a class="button" href="/board'.$club->getId().'/create" onclick="return showCreateTopicModal(event, '.$club->getId().', '.($canModify ? 'true' : 'false').')">'.tr('create_topic').'</a>'}
    {/if}
    <div class="page_block">
        {include "../components/page_crumb_header.latte", crumbs: [
            ['href' => $club->getURL(), 'title' => $club->getCanonicalName()], 
            ['title' => tr("discussions"), 'count' => sizeof($topics)]
        ], extra => '<div class="buttons_row">' . $extraActions . '</div>'
        }
        {include "../components/search_bar.latte",
            action => '/board'.$club->getId(),
            input_value => $_GET['query'] ?? '',
            input_name => 'query',
            id => 'topics_search_header',
        }

        <div class="list_view">
            {var $data = is_array($topics) ? $topics : iterator_to_array($topics)}

            {if sizeof($data) > 0}
                <div class="search_row" n:foreach="$data as $x">
                    <div class="info fl_l">
                        <div class="labeled name">
                            <a href="/topic{$x->getPrettyId()}">
                                <b>
                                    {$x->getTitle()}
                                    <div n:if="$x->isPinned()" class="pinned-mark"></div>
                                </b>
                            </a>
                        </div>
                        <div class="labeled">
                            {if $x->isChatAttached()}
                                {tr("chat")}
                            {else}
                                {tr("messages", $x->getCommentsCount())}
                            {/if}
                        </div>
                        {var $lastComment = $x->getLastComment()}
                    </div>
                    <a href="/topic{$x->getPrettyId()}#_comment{$lastComment->getId()}" n:if="$lastComment" class="controls blist_last">
                        <div class="avatar">
                            {include '../components/avatar.latte', author => $lastComment->getOwner(), size => 'miniscule', class => 'ava'}
                        </div>
                        <div class="info">
                            <div class="labeled name">{$lastComment->getOwner()->getCanonicalName()}</div>
                            <div class="labeled">{_replied} {$lastComment->getPublicationTime()}</div>
                        </div>
                    </a>
                </div>
                {include "../components/paginator.latte", conf => (object) [
                    "page"     => $page,
                    "count"    => $paginatorConf->count,
                    "amount"   => sizeof($data),
                    "perPage"  => $perPage ?? \OPENVK_DEFAULT_PER_PAGE,
                    "atBottom" => true,
                ]}
            {else}
                {include "../components/nothing.latte"}
            {/if}
        </div>
    </div>
{/block}
