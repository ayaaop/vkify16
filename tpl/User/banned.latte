{extends "../@layout.latte"}
{var $transparentAppbar = true}
{var $avatarNormal = null}
{block title}{$user->getCanonicalName()}{/block}

{block headIncludes}
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/profile.css" data-vkify-route-style="profile" />
{/block}

{block appbar_extra}{include '../components/profile_appbar_extra.latte', noAnimate => true}{/block}

{block content}
    {capture $body}
        {tr("user_banned", htmlentities($user->getFirstName()))|noescape}<br/>
        {_user_banned_comment} <b>{$user->getBanReason()}</b>.<br/>
        {_user_is_blocked}
        <span n:if="$user->getUnbanTime() !== NULL">{_before}: <b>{$user->getUnbanTime()}</b></span>
        <span n:if="$user->getUnbanTime() === NULL"><b>{_forever}</b></span>
    {/capture}
    {capture $extra}
        <div class="profile_deleted_actions buttons_row" n:if="isset($thisUser) && $thisUser->getChandlerUser()->can('access')->model('admin')->whichBelongsTo(NULL)">
            <a class="button button_gray" href="javascript:unbanUser()">{_unban_user_action}</a>
            <a class="button button_gray" n:if="$thisUser->getChandlerUser()->can('write')->model('openvk\Web\Models\Entities\TicketReply')->whichBelongsTo(0)" href="javascript:toggleBanInSupport()">
                {if $user->isBannedInSupport()}{_unban_in_support_user_action}{else}{_ban_in_support_user_action}{/if}
            </a>
        </div>
    {/capture}
    {include '../components/profile_unavailable.latte',
        status => tr('user_is_blocked'),
        statusClass => 'profile_deleted',
        body => $body,
        bodyClassDesktop => 'profile_deleted_text',
        bodyClassMobile => 'profile_deleted_text',
        extra => $extra,
        disablePhotoViewer => false}
{/block}
