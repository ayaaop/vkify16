{extends "../@listView.latte"}
{var $iterator = $user->getClubs($page, $admin)}
{var $count    = $user->getClubCount($admin)}

{block title}
    {_groups}
{/block}

{block appbar_extra}
<div n:if="$user->getId() === $thisUser->getId()" class="mobileonly" id="group_appbar_extra">
    <a class="appbar-extra-btn" href="/groups_create" onclick="showCreateGroupModal(event)" aria-label="{_create_group}">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><use href="#add-outline-24"></use></svg>
    </a>
</div>
{/block}

{block noscroll}{/block}

{* BEGIN ELEMENTS DESCRIPTION *}

{block tabs}
    {if !is_null($thisUser) && $user->getId() === $thisUser->getId()}
        {var $count = $user->getClubCount()}
        {var $tabs = [
            [
                'url' => "/groups{$user->getId()}",
                'title' => 'groups',
                'active' => !$admin,
                'id' => 'groups_tab_all',
                'count' => $count
            ],
            [
                'url' => "/groups{$user->getId()}?act=managed",
                'title' => 'managed',
                'active' => $admin,
                'id' => 'groups_tab_managed',
                'count' => $user->getClubCount(true)
            ]
        ]}
        {var $createGroupButton = '<a class="button nomobile" href="/groups_create" onclick="showCreateGroupModal(event)">' . tr('create_group') . '</a>'}
        {include "../components/page_tabs_header.latte", tabs => $tabs, id => 'groups_top_tabs', extra => $createGroupButton}
    {else}
        {include "../components/page_block_header.latte", title => 'groups'}
    {/if}
    {include "../components/search_bar.latte",
        id => 'groups_search_header',
        placeholder => tr('search_by_groups'),
        action => '/search',
        section => 'groups',
        class => 'groups_search_header'
    }
{/block}

{block link|strip|stripHtml}
    {$x->getURL()}
{/block}

{block preview}
	{include '../components/avatar.latte', author => $x, size => 'miniscule', width => 80, alt => $x->getCanonicalName()}
{/block}

{block name}{/block}

{block infotable}
    <div class="labeled name">
        <a href="{$x->getURL()}" {if mb_strlen($x->getName()) > 100}title="{$x->getName()}"{/if}>{$x->getName()|truncate:100}</a>
        <a class="page_verified" n:if="$x->isVerified()" href="/verify"></a>
    </div>
    <div class="labeled">
         <a href="/club{$x->getId()}/followers">{tr("participants", $x->getFollowersCount())}</a></td>
    </div>
{/block}

{block actions}
    <div class="post_actions ui_actions_menu_wrap" onmouseover="uiActionsMenu.show(this);" onmouseout="uiActionsMenu.hide(this);">
        <div class="post_actions_icon"></div>
        <div id="group_actions_menu_{$x->getId()}" class="ui_actions_menu">
            {if $x->canBeModifiedBy($thisUser ?? NULL)}
                {var $clubPinned = $thisUser->isClubPinned($x)}
                <a href="/groups_pin?club={$x->getId()}&hash={rawurlencode($csrfToken)}" n:if="$clubPinned || $thisUser->getPinnedClubCount() <= 10" id="_pinGroup" data-group-name="{$x->getName()}" data-group-url="{$x->getUrl()}">
                    {if $clubPinned}
                        {_remove_from_left_menu}
                    {else}
                        {_add_to_left_menu}
                    {/if}
                </a>
            {/if}
            {if $x->getSubscriptionStatus($thisUser) == false}
                <a href="javascript:void(0)" onclick="this.closest('.ui_actions_menu').querySelector('form[data-action=add]').submit()">{_join_community}</a>
                <form style="display: none" data-action="add" action="/setSub/club" method="post">
                    <input type="hidden" name="act" value="add" />
                    <input type="hidden" name="id" value="{$x->getId()}" />
                    <input type="hidden" name="hash" value="{$csrfToken}" />
                </form>
            {else}
                <a href="javascript:void(0)" onclick="this.closest('.ui_actions_menu').querySelector('form[data-action=rem]').submit()">{_leave_community}</a>
                <form style="display: none" data-action="rem" action="/setSub/club" method="post">
                    <input type="hidden" name="act" value="rem" />
                    <input type="hidden" name="id" value="{$x->getId()}" />
                    <input type="hidden" name="hash" value="{$csrfToken}" />
                </form>
            {/if}
        </div>
    </div>
{/block}

{block narrow}
    {var $menuItems = [
        [
            'url' => '/groups' . $user->getId(),
            'title' => 'groups',
            'active' => true
        ],
        [
            'url' => '/events' . $user->getId(),
            'title' => 's_events'
        ],
        [
            'url' => '/search?section=groups',
            'title' => 'search_for_groups',
            'condition' => $user->getId() === $thisUser->getId()
        ]
    ]}
    {include "../components/ui_rmenu.latte",
        items => $menuItems,
        ownblockData => $user->getId() !== $thisUser->getId() ? $user : null
    }
    {if !is_null($thisUser)}
        <div class="page_block module page_list_module groups_module nomobile">
            <a href="/search?section=groups" class="module_header">
                <h3 class="header_top clear_fix">
                    <span class="header_label fl_l">
                        {=vkifyTr('recommended_groups')|noescape}
                    </span>
                </h3>
            </a>
            <div class="module_body clear_fix">
                {var $clubsRepo = new \openvk\Web\Models\Repositories\Clubs()}
                {var $totalClubs = $clubsRepo->getCount()}
                {var $randomClubs = []}
                {if $totalClubs > 0}
                    {var $poolSize = min(20, $totalClubs)}
                    {var $randomIds = []}
                    {while count($randomIds) < $poolSize}
                        {var $candidateId = rand(1, $totalClubs)}
                        {if !in_array($candidateId, $randomIds)}
                            {var $randomIds[] = $candidateId}
                        {/if}
                    {/while}
                    {var $candidateClubs = $clubsRepo->getByIds($randomIds)}
                    {var $eligibleClubs = []}
                    {foreach $candidateClubs as $clubCandidate}
                        {if $clubCandidate && !$clubCandidate->isHideFromGlobalFeedEnabled() && !$clubCandidate->isHidingFromGlobalFeedEnforced() && !$clubCandidate->isBanned() && $clubCandidate->getSubscriptionStatus($thisUser) == false}
                            {var $eligibleClubs[] = $clubCandidate}
                        {/if}
                    {/foreach}
                    {var $randomClubs = array_slice($eligibleClubs, 0, 5)}
                {/if}
                {if count($randomClubs) > 0}
                    <div class="line_cell clear_fix" n:foreach="$randomClubs as $club">
                        <div class="thumb">
                            <a href="club{$club->getId()}">
                                {include '../components/avatar.latte', author => $club, size => 'miniscule', alt => $club->getCanonicalName(), class => 'cell_img'}
                            </a>
                        </div>
                        <div class="desc_info">
                            <div class="group_name"><a href="club{$club->getId()}">{$club->getName()}</a></div>
                            <div class="group_desc">
                                <span>{$club->getDescription()}</span>
                            </div>
                        </div>
                    </div>
                    <div class="line_cell">
                        <a href="/search?section=groups" class="button button_gray button_wide">{_show_more}</a>
                    </div>
                {else}
                    {include "../components/content_error.latte", icon => false, description => tr("groups_zero")}
                {/if}
            </div>
        </div>
    {/if}
{/block}
