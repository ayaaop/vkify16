{extends "../@layout.latte"}
{php if (!function_exists('vkifyFormatCount')) require_once \OPENVK_ROOT . '/themepacks/vkify16/res/php/vkify_helpers.php';}

{block title}{_video}{/block}

{block content}
    <div class='page_block'>
        {include "../components/page_crumb_header.latte", crumbs: [
            ['href' => $user->getURL(), 'title' => $user->getCanonicalName()],
            ['href' => "/videos{$user->getId()}", 'title' => tr("videos")],
            ['title' => $video->getName()]
        ]}
        <div class="video_block_layout" style="padding-top: 20px;">
            {if $video->getType() === 0}
                <div class="bsdn" style="--post-image: url({$video->getThumbnailURL()|noescape})" data-id="{$video->getPrettyId()}" data-name="{$video->getName()}" data-author="{$user->getCanonicalName()}" data-duration="{$video->getFormattedLength()}">
                    <video data-src="{$video->getURL()}"></video>
                </div>
            {else}
                {var $driver = $video->getVideoDriver()}
                {if !$driver}
                    {_unknown_video}
                {else}
                    {$driver->getEmbed()|noescape}
                {/if}
            {/if}
        </div>
        <div class="ovk-vid-details">
            <div class="video_info">
                <div class='video_info_title'>
                    {$video->getName()}
                </div>
                <div class="video_info_actions">
                    {if isset($thisUser)}
                        {if $thisUser->getId() != $video->getOwner()->getId()}
                            {var $canReport = true}
                        {else}
                            {var $canEdit = true}
                        {/if}
                        {var $liked = $video->hasLikeFrom($thisUser)}
                        {var $likesCount = $video->getLikesCount()}
                        <a href="/video{$video->getPrettyId()}/like?hash={rawurlencode($csrfToken)}" class="video_like_button button video_like_wrap" onmouseover="vkifyLikesShow(this)" data-liked="{(int) $liked}" data-likes="{$likesCount}" data-id="{$video->getPrettyId()}" data-type='video'>
                            <svg class="action_icon" id="{if $liked}liked{/if}"><use class="i16" href="#like-16" width="100%" height="100%"/><use class="i18" href="#like-outline-24" width="100%" height="100%"/><use class="i18 iact" href="#like-active-24" width="100%" height="100%"/></svg>
                            <span class="action_label">{tr('mobile_like')}</span>
                            <span class="action_count">{if $likesCount > 0}{=vkifyFormatCountSpaced($likesCount)}{/if}</span>
                        </a>
                        <a onclick="javascript:repost({$video->getPrettyId()}, 'video')" class="video_share_button button button_light">
                            <svg class="action_icon"><use class="i16" href="#share-14" width="100%" height="100%"/><use class="i18" href="#share-arrow-24" width="100%" height="100%"/></svg>
                            <span class="action_label">{tr('share')}</span>
                        </a>
                        <span class="video_info_more_actions ui_actions_menu_wrap" onmouseover="{='uiActionsMenu.show(this, null, {appendParentCls: "body"});'|noescape}" onmouseout="uiActionsMenu.hide(this);">
                            <div class="button button_light _more_wrap">{_show_more}</div>
                            <div id="videoMoreActionsTooltip" class="ui_actions_menu">
                                <a n:if="$canEdit ?? false" href="javascript:showEditVideoModal('{$video->getPrettyId()}')">
                                    {tr('edit')}
                                </a>
                                <a n:if="$canEdit ?? false" href="/video{$video->getPrettyId()}/remove">
                                    {tr('delete')}
                                </a>
                                {if $video->canCloseComments($thisUser)}
                                    <a n:if="!$video->isCommentsClosed()" onclick="onCloseCommentsClick(event, true, {$video->getPrettyId()}, 'video')">{_close_post_comments}</a>
                                    <a n:if="$video->isCommentsClosed()" onclick="onCloseCommentsClick(event, false, {$video->getPrettyId()}, 'video')">{_open_post_comments}</a>
                                {/if}
                                <a n:if="$canReport ?? false" href="javascript:reportVideo({$video->getId()})">
                                    {tr('report')}
                                </a>
                                <a n:if="$video->getType() == 0" href="{$video->getURL()}" download="">
                                    {tr('download_video')}
                                </a>
                            </div>
                        </span>
                    {/if}
                </div>
                {include "../components/like_faces.latte", item => $video, type => 'video'}
                <div class="video_info_author clear_fix">
                    <a href="{$video->getOwner()->getURL()}" class="video_info_author_image">
                        {include '../components/avatar.latte', author => $video->getOwner(), size => 'miniscule', class => 'post-avatar'}
                    </a>
                    <div class="video_info_author_info">
                        <div class="video_info_author_name">
                            <a href="{$video->getOwner()->getURL()}">{$video->getOwner()->getCanonicalName()}</a>
                        </div>
                        <div class="video_info_author_date">
                            {$video->getPublicationTime()}
                        </div>
                    </div>
                </div>
                <div class="video_info_description" n:if="($canEdit ?? false) || $video->getDescription()">
                    {if $canEdit ?? false}
                        {var $vDescPlain = $video->getDescription() ?? ''}
                        {if !empty($vDescPlain)}
                            {include "../components/truncated_text.latte", html => $video->getDescription(), plain => $vDescPlain, limit => 500, isEditable => true, editUrl => "javascript:showEditVideoModal('" . $video->getPrettyId() . "')"}
                        {else}
                            <div class="pv_can_edit pv_desc_cont" data-edit-url="javascript:showEditVideoModal('{$video->getPrettyId()}')" role="button" tabindex="0">
                                <span class="pv_no_description">{_no_description}</span>
                            </div>
                        {/if}
                    {else}
                        {include "../components/truncated_text.latte", html => $video->getDescription(), limit => 500}
                    {/if}
                </div>
            </div>
            <div class="clear_fix video_comments">
                {include "../components/comments.latte",
                        comments => $comments,
                        count => $cCount,
                        page => $cPage,
                        model => "videos",
                        parent => $video}
            </div>
        </div>
    </div>
{/block}
