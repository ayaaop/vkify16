{extends "../@layout.latte"}
{block title}
    {tr("users_gifts", $user->getFirstName())}
{/block}

{block content}
    <div class="page_block scroll_container">
        {include "../components/page_crumb_header.latte", crumbs: [
            ['href' => $user->getURL(), 'title' => $user->getCanonicalName()],
            ['title' => tr("gifts"), 'count' => $count]
        ], extra: '<a href="/gifts?act=pick&user='.$user->getId().'" class="button">'.tr('send_gift').'</a>'}
        {var $data = is_array($iterator) ? $iterator : iterator_to_array($iterator)}
        {if sizeof($data) > 0}
            <div class="scroll_node" data-uniqueid="usergift-{$x->id}" n:foreach="$data as $x">
                <div class="post gift">
                    <div class="post_header">
                        <a class="post_image" href="{!$x->anon ? $x->sender->getURL() : 'javascript:false'}">
                            {if !$x->anon}
                                {include '../components/avatar.latte', author => $x->sender, size => 'miniscule', width => 50, class => 'post-avatar'}
                            {else}
                                <img src="/themepack/vkify16/{$theme->getVersion()}/resource/camera_200.png" width="50" class="avatar post-avatar" />
                            {/if}
                        </a>
                        <div class="post_header_info">
                            <div class="post_author">
                                <a class="author" href="{!$x->anon ? $x->sender->getURL() : 'javascript:false'}">
                                    {$x->anon ? tr("track_unknown") : $x->sender->getCanonicalName()}
                                </a>
                            </div>
                            {*<div class="post_date">
                                <a href="#" class="post_link">
                                    {$x->getPublicationTime()}
                                </a>
                            </div>*}
                        </div>
                    </div>
                    <div class="post-content wall_text">
                        <div class="gift_image">
                            <img src="{$x->gift->getImage(2)}" alt="{_gift}" loading=lazy />
                        </div>
                        <div class="gift_description">
                            {$x->caption}
                        </div>
                    </div>
                    {if $user->getId() === $thisUser->getId() && !$x->anon}
                        <div class="gift_button">
                            <a href="/gifts?act=pick&user={$x->sender->getId()}" class="button ">{_send_gift}</a>
                        </div>
                    {/if}
                </div>
            </div>
            {include "../components/paginator.latte", conf => (object) [
                "page"     => $page,
                "count"    => $count,
                "amount"   => sizeof($data),
                "perPage"  => $perPage ?? \OPENVK_DEFAULT_PER_PAGE,
                "atBottom" => true,
            ]}
        {else}
            {include "../components/content_error.latte", description => tr("no_data_description")}
        {/if}
    </div>
{/block}
