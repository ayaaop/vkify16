{extends "../@layout.latte"}
{block title}
    {_gift_select}
{/block}

{block content}
    <div class="page_block">
        {include "../components/page_crumb_header.latte", crumbs: [
            ['href' => 'javascript:false', 'title' => tr("send_gift")],
            ['href' => $user->getURL(), 'title' => $user->getCanonicalName()],
            ['href' => "/gifts?act=pick&user={$user->getId()}", 'title' => tr("collections")],
            ['title' => $cat->getName(tr("__lang")), 'count' => $count]
        ]}
        <div class="gifts_section_row">
            <div class="gift_section_info">
                <h4 class="gifts_section_header">
                    {$cat->getName(tr("__lang"))}
                </h4>
                <div class="gifts_section_description">
                    {$cat->getDescription(tr("__lang"))}
                </div>
            </div>
            {if sizeof($gifts) > 0}
                <div class="gift_section_wrap gifts_section_scroll scroll_container clear_fix">
                    {foreach $gifts as $gift}
                        <a href='/gifts?act=confirm&user={$user->getId()}&pack={$cat->getId()}&elid={$gift->getId()}' n:class="scroll_node, gift_cell, !$gift->canUse($thisUser) ? disabled" data-gift="{$gift->getId()}" data-uniqueid="gift-{$gift->getId()}">
                            <img width="107.5" height="107.5" class="gift_img" src="{$gift->getImage(2)}" alt="{_gift}" loading=lazy />
                            <div class="{if $gift->isFree() || $gift->getPrice() <= 2}gift_free{else}gift_price{/if}">
                                {if $gift->isFree()}
                                    {_free_gift}
                                {else}
                                    {tr('coins', $gift->getPrice())}
                                {/if}
                            </div>

                            <div n:if="$gift->getUsagesLeft($thisUser) !== \INF" class="gift_limit">
                                {=vkifyTr('gifts_left', $gift->getUsagesLeft($thisUser))|noescape}
                            </div>
                        </a>
                    {/foreach}
                </div>
            {else}
                {include "../components/content_error.latte", description => tr("no_data_description")}
            {/if}
        </div>
        {include "../components/paginator.latte", conf => (object) [
            "page"    => $page,
            "count"   => $count,
            "amount"  => sizeof($gifts),
            "perPage" => \OPENVK_DEFAULT_PER_PAGE,
            "atBottom" => true,
            "tidy"     => true,
        ]}
    </div>
{/block}
