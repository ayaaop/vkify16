{block content}
    {if !$message}
        {include "../../components/content_error.latte", title => tr("no_data"), description => tr("reported_message_display_error")}
    {else}
        <style>
            #reported_msg_context .reportedMsg {
                outline: 2px solid #e646466b
            }
            #reported_msg_context .deletedBadge {
                display: inline-block;
                font-size: 10px;
                color: #d9534f;
                margin-left: 5px;
                vertical-align: middle;
            }
        </style>

        <div id="reported_msg_context">
            <p>{_reported_msg_1}: {$message->getPeerId()}</p>
            <p>{_reported_msg_2}: {$message->getSenderId()}</p>
            <p>{_reported_msg_3}</p>
            <hr>
            {var $prevSenderId = null}
            {var $prevTime = 0}
            {foreach $message->getContext(0) as $item}
                {var $owner = $item->getOwner()}
                {var $sendTs = $item->getSendTime()->format('U', true)}
                <div n:class="'messenger-app--messages---message messenger-layer msg-hoverable', $item->isUnread() ? 'unread' : 'msg-read', $prevSenderId === $item->getSenderId() && ($sendTs - $prevTime) < 600 ? 'same-author', $item->getId() == $message->getId() ? 'reportedMsg', $item->isDeleted() ? 'msg-deleted', $item->getEditTime() ? 'msg-edited'">
                    <div class="messenger-app--messages---message--wrap">
                        <div class="inlines _avatar">
                            {if $owner}
                                <img class="ava" src="{$owner->getAvatarUrl()}" />
                            {else}
                                <div class="ava" style="background: var(--page-background-color--secondary); border-radius: 50%; width: 36px; height: 36px;"></div>
                            {/if}
                        </div>
                        <div class="inlines _content">
                            <div class="msg-header-right">
                                <div class="time"><span>{$item->getSendTimeHumanized()}</span></div>
                            </div>
                            {if $owner}
                                <a class="_sender" target="_blank" href="{$owner->getURL()}">
                                    <strong>{$owner->getCanonicalName()}</strong>
                                </a>
                            {else}
                                <span class="_sender"><strong>ID: {$item->getSenderId()}</strong></span>
                            {/if}
                            {if $item->isDeleted()}
                                <span class="deletedBadge">({_deleted})</span>
                            {/if}
                            <p class="normalText text">{$item->getText()}</p>
                            <p n:if="$item->getEditTime()" class="msg-modificators"><p class="modificator-edited">{_edit_action_past}</p></p>
                            {var $attachmentsLayout = $item->getChildrenWithLayout(200)}
                            <div n:ifcontent class="msg-attachments-container">
                                <div n:ifcontent class="attachments attachments_b" style="height: {$attachmentsLayout->height|noescape}; width: {$attachmentsLayout->width|noescape};">
                                    <div class="attachment" n:foreach="$attachmentsLayout->tiles as $attachment" style="float: {$attachment[3]|noescape}; width: {$attachment[0]|noescape}; height: {$attachment[1]|noescape};">
                                        {include "../../components/attachment.latte", attachment => $attachment[2], tilesCount => sizeof($attachmentsLayout->tiles)}
                                    </div>
                                </div>
                                <div n:ifcontent class="attachments">
                                    <div class="attachment" n:foreach="$attachmentsLayout->extras as $attachment">
                                        {include "../../components/attachment.latte", attachment => $attachment}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {var $prevSenderId = $item->getSenderId()}
                {var $prevTime = $sendTs}
            {/foreach}
        </div>
    {/if}
{/block}
