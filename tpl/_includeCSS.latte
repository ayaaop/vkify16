{css "css/main.css"}
{css "css/bsdn.css"}
{css "css/dialog.css"}
{css "css/nsfw-posts.css"}
{css "css/avatar-edit.css"}
{css "css/audios.css"}
{if $isXmas}
    {css "css/xmas.css"}
{/if}
{css "css/messages.css"}
{css "css/fastchats.css"}
{css "css/calendar.css"}
{css "css/emoji/emoji.css"}

<link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/stylesheet/styles.css" />
<link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/ui_common.css" />
<link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/notifications.css" />
<link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/modals.css" />
<link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/player.css" />
<link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/messenger.css" />
<link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/mobile.css" />

{if $isXmas}
    <link rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/xmas.css" />
{/if}
{ifset $thisUser}
    {if $thisUser->getStyleAvatar() == 1}
        <link id="vkify-style-square_avatars" rel="stylesheet" href="/themepack/{$theme->getId()}/{$theme->getVersion()}/resource/css/square_avatars.css" />
    {/if}
    {else}
    <style>
        .logged-out .post-content {
            padding-bottom: 15px;
        }
        .logged-out .reply .post-content {
            padding-bottom: 0;
        }
    </style>
{/ifset}
