{extends "../@layout.latte"}
{block title}{_wall}{/block}

{block content}
{var $archiveYearExtraItem = fn($year) => [
        'url' => '#',
        'class' => 'archive_actions',
        'condition' => $type == 'archive' && ($archiveYear ?? null) === $year,
        'content' => '<span class="archive_actions_icon ui_actions_menu_wrap" onmouseover="uiActionsMenu.show(this, null, {menuId: \'archive_year_actions_' . $year . '\', align: \'right\', appendParentCls: \'page_body\'});" onmouseout="uiActionsMenu.hide(this);"></span>',
        'onclick' => 'event.preventDefault(); event.stopPropagation();'
    ]}
{var $archiveMenuSubitems = array_map(fn($year) => [
        'url' => '/wall' . $owner . '?type=archive&year=' . $year,
        'title' => (string) $year,
        'translate' => false,
        'active' => $type == 'archive' && ($archiveYear ?? null) === $year,
        'extraItem' => $archiveYearExtraItem($year)
    ], $archiveYears ?? [])
}
{capture $archiveAllActionsMenu}
    <div id="archive_all_actions_menu" class="ui_actions_menu">
        <form method="post" action="/wall{$owner}/archive/manage">
            <input type="hidden" name="hash" value="{$csrfToken}">
            <input type="hidden" name="action" value="archive_all">
            <button type="submit" data-confirm="{_archive_confirm_all}" onclick="return confirm(this.dataset.confirm)">{_archive_all_posts}</button>
        </form>
    </div>
{/capture}
{capture $archiveYearActionsMenus}
    {foreach $archiveYears ?? [] as $year}
        <div id="archive_year_actions_{$year}" class="ui_actions_menu">
            <form method="post" action="/wall{$owner}/archive/manage">
                <input type="hidden" name="hash" value="{$csrfToken}">
                <input type="hidden" name="action" value="archive_year">
                <input type="hidden" name="year" value="{$year}">
                <button type="submit" data-confirm="{tr('archive_confirm_year', $year)}" onclick="return confirm(this.dataset.confirm)">{tr('archive_all_posts_from_year', $year)}</button>
            </form>
            <form method="post" action="/wall{$owner}/archive/manage">
                <input type="hidden" name="hash" value="{$csrfToken}">
                <input type="hidden" name="action" value="restore_year">
                <input type="hidden" name="year" value="{$year}">
                <button type="submit" data-confirm="{tr('restore_confirm_year', $year)}" onclick="return confirm(this.dataset.confirm)">{tr('restore_all_posts_from_year', $year)}</button>
            </form>
        </div>
    {/foreach}
{/capture}
{var $archiveActionsExtraItem = [
    'url' => '#',
    'class' => 'archive_actions',
    'condition' => $type == 'archive',
    'content' => '<span class="archive_actions_icon ui_actions_menu_wrap" onmouseover="uiActionsMenu.show(this, null, {menuId: \'archive_all_actions_menu\', align: \'right\', appendParentCls: \'page_body\'});" onmouseout="uiActionsMenu.hide(this);"></span>',
    'onclick' => 'event.preventDefault(); event.stopPropagation();'
]}
{var $menuItems = [
    [
        'url' => '/wall' . $owner . '?type=owners',
        'title' => isset($club) ? "clubs_posts" : tr("users_posts", ovk_proc_strtr($oObj->getFirstName(), 20)),
        'translate' => isset($club) ? true : false,
        'active' => $type == 'owners'
    ],
    [
        'url' => '/wall' . $owner,
        'title' => 'all_posts',
        'active' => $type == 'all'
    ],
    [
        'url' => "/notes" . $owner,
        'title' => 'notes',
        'active' => false,
        'condition' => $owner > 0
    ],
    [
        'url' => '/wall' . $owner . '?type=archive',
        'title' => 'archived_posts',
        'active' => $type == 'archive' && ($archiveYear ?? null) === null,
        'subitems' => $archiveMenuSubitems,
        'extraItem' => $archiveActionsExtraItem,
        'condition' => isset($thisUser) && (
            ($owner > 0 && $thisUser->getId() === $oObj->getId()) ||
            ($owner < 0 && isset($club) && $club->canBeModifiedBy($thisUser))
        )
    ]
]}
{var $visiblePosts = (isset($club) && $type == 'owners' && !empty($_GET['__vkify16_tab'])) ? array_filter($posts, fn($post) => !$post->isPinned()) : $posts}
{var $wallPosts = $type == 'archive' ? $posts : $visiblePosts}
    <div class="wide_column_left">
        <div class="narrow_column_wrap">
            <div class="narrow_column">
                {include "../components/ui_rmenu.latte", items => $menuItems, ownblockData => $oObj}
            </div>
        </div>
        <div class="wide_column_wrap">
            <div class="wide_column">
                <div n:if="$canPost && $type != 'archive'" class="page_block postFeedWrapperMicroblog">
                    {include "../components/textArea.latte", route => "/wall$owner/makePost", graffiti => true, polls => true, notes => true, hasSource => true, geo => true}
                </div>
                <div class="page_block wall_posts_tabs">
                    {include "../components/page_block_header.latte", title => $type == 'search' ? 'search_results' : 'wall', extra => '<a href="/wall'.$owner.'/rss" class="button">'.tr('read_in_rss').'</a>'}
                </div>
                {capture $wallPostsContent}
                    <div id="{$type == 'owners' ? 'owner_posts' : ($type == 'archive' ? 'archive_wall_posts' : 'all_posts')}" class="content scroll_container">
                        <div class="page_block" style="margin: 0">
                            {include "../components/search_bar.latte",
                                id => 'wall_search',
                                form_id => 'wall_search_form',
                                action => "/wall{$owner}",
                                input_name => 'q',
                                input_value => $_GET['q'] ?? '',
                                hidden_fields => ['type' => 'search'],
                                class => '_wrap ui_search_old'}
                        </div>
                        {if sizeof($wallPosts) > 0}
                            {foreach $wallPosts as $post}
                                {include "../components/post.latte", post => $post, commentSection => true}
                            {/foreach}
                            {include "../components/paginator.latte", conf => $paginatorConf}
                        {/if}
                        <div class="page_block placeholder {if sizeof($wallPosts) !== 0}hidden{/if}">
                            {include "../components/content_error.latte",
                                description => $type == 'search' ? tr('no_found') : tr('no_posts_abstract')
                            }
                        </div>
                    </div>
                {/capture}

                {if $type == 'archive'}
                    {$archiveAllActionsMenu|noescape}
                    {$archiveYearActionsMenus|noescape}
                    <div id="archive_posts_container">
                    <div class="page_block archive_banner">
                        <div class="archive_banner_text">
                            <b class="archive_banner_title">{_archive_banner_title}</b>
                            <span class="archive_banner_description">{_archive_banner_desc}</span>
                        </div>
                    </div>

                    {$wallPostsContent|noescape}
                </div>
                {else}
                    {$wallPostsContent|noescape}
                {/if}
            </div>
        </div>
    </div>
{/block}

{block bodyScripts}
    <script src="/themepack/vkify16/{$theme->getVersion()}/resource/js/features/suggestions.js"></script>
    <script n:if='$type == "search" && sizeof($posts) > 0 && !empty($_GET["q"])' data-vkify-route-script="wall-search-highlight">
        function __scrollHook(page) {
            highlightText({$_GET["q"]}, '.content', ['.wall_post_text'])
        }
        __scrollHook()
    </script>
{/block}
